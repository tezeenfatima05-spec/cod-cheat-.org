---
interface Props {
  eyebrow: string;
  title: string;
  desc?: string;
  titleId?: string;
  /** FAQ page uses an outer <h1>; inner section title should be <h2> to avoid duplicate H1s. */
  titleLevel?: 'h1' | 'h2';
  centered?: boolean;
  wide?: boolean;
}

const { eyebrow, title, desc, titleId, titleLevel = 'h1', centered = false, wide = false } = Astro.props;
---

<header
  class:list={[
    'section-header space-y-0',
    wide && 'section-header--wide',
    centered && 'mx-auto text-center',
  ]}
>
  <p class="section-header__eyebrow">{eyebrow}</p>
  {
    titleLevel === 'h2' ? (
      <h2 id={titleId} class="section-header__title">{title}</h2>
    ) : (
      <h1 id={titleId} class="section-header__title">{title}</h1>
    )
  }
  {desc ? <p class="section-header__subtitle">{desc}</p> : null}
</header>
