---
import type { BlogPost } from '../../i18n/types';
import SectionHeader from '../SectionHeader.astro';
import BlogCard from '../BlogCard.astro';
import { Button } from '@/components/starwind/button';
import Icon from '../icons/Icon.astro';
import { ROUTES } from '../../utils/path';
import { canonicalUrl, resolveDocumentOrigin } from '../../config/seo';

interface Props {
  posts: BlogPost[];
  productName: string;
  linkBase?: string;
}

const { posts, productName, linkBase: linkBaseProp } = Astro.props;
const schemaOrigin = linkBaseProp ?? resolveDocumentOrigin(Astro.site);
const blogHubHref = canonicalUrl(ROUTES.blog, schemaOrigin);
---

{
  posts.length > 0 && (
    <section class="border-t border-border bg-muted/20 py-16 md:py-24" aria-labelledby="related-guides-heading">
      <div class="mx-auto max-w-6xl px-5">
        <SectionHeader
          eyebrow="Guides"
          title={`Learn more about ${productName}`}
          desc="Curated articles for setup, tuning, and patch-day checks that match this product."
          titleId="related-guides-heading"
        />

        <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-y-10">
          {posts.map((post, i) => (
            <BlogCard post={post} index={i} showDate linkBase={schemaOrigin} />
          ))}
        </div>

        <div class="mt-12 flex justify-start lg:justify-center">
          <Button as="a" href={blogHubHref} variant="outline" class="rounded-full">
            Browse all guides
            <Icon name="arrowRight" size={17} />
          </Button>
        </div>
      </div>
    </section>
  )
}
