---
import type { BreadcrumbItem } from '../utils/schema';
import {
  Breadcrumb,
  BreadcrumbItem as CrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/starwind/breadcrumb';

interface Props {
  items: BreadcrumbItem[];
  /** When set, prefix internal paths so crawlers see absolute same-origin URLs */
  absoluteBase?: string;
}

const { items, absoluteBase } = Astro.props;

function crumbHref(path: string): string {
  if (path.startsWith('http://') || path.startsWith('https://')) return path;
  const base = absoluteBase?.replace(/\/$/, '') ?? '';
  return base ? `${base}${path.startsWith('/') ? path : `/${path}`}` : path;
}
---

<Breadcrumb class="mb-4">
  <BreadcrumbList>
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <>
          <CrumbItem>
            {isLast ? (
              <BreadcrumbPage>{item.name}</BreadcrumbPage>
            ) : (
              <BreadcrumbLink href={crumbHref(item.path)}>
                <span class="sr-only">Breadcrumb · </span>
                {item.name}
              </BreadcrumbLink>
            )}
          </CrumbItem>
          {!isLast && <BreadcrumbSeparator />}
        </>
      );
    })}
  </BreadcrumbList>
</Breadcrumb>
