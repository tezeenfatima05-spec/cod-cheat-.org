---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo, canonicalUrl, resolveDocumentOrigin } from '../config/seo';
import { ROUTES, blogPostPath } from '../utils/path';

const seo = resolvePageSeo('/about/');
import LegalPage from '../components/LegalPage.astro';
import { breadcrumbSchema, organizationSchema, webPageSchema } from '../utils/schema';

const content = t.legalPages.about;
const schemaOrigin = resolveDocumentOrigin(Astro.site);
const shareUrl = canonicalUrl('/about/', schemaOrigin);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  sharePageUrl={shareUrl}
  sharePageTitle={seo.title}
  jsonLd={[
    organizationSchema(schemaOrigin),
    webPageSchema({
      name: 'About COD Cheats — tiers, guides, site publishing',
      description: content.description,
      url: '/about/',
      origin: schemaOrigin,
    }),
    breadcrumbSchema(
      [
        { name: 'Home', path: '/' },
        { name: 'About', path: '/about/' },
      ],
      schemaOrigin,
    ),
  ]}
>
  <div class="sr-only" aria-label="Related site pages">
    <a href={`${schemaOrigin}/sitemap.xml`}>Crawl map — XML sitemap for every route</a>
    <a href={canonicalUrl(ROUTES.home, schemaOrigin)}>Site entry — COD MW4 homepage</a>
    <a href={canonicalUrl(ROUTES.blog, schemaOrigin)}>Guides archive — newest posts first</a>
    <a href={canonicalUrl(blogPostPath('mw4-lite-vs-pro'), schemaOrigin)}>Lite versus Pro — feature tradeoffs</a>
    <a href={canonicalUrl(ROUTES.privacy, schemaOrigin)}>Data practices — privacy statement</a>
    <a href={canonicalUrl(ROUTES.faq, schemaOrigin)}>Help center — licensing FAQ topics</a>
    <a href={canonicalUrl(ROUTES.support, schemaOrigin)}>Contact support — orders and loaders</a>
  </div>
  <LegalPage
    title={content.title}
    pageTitle="About COD Cheats — tiers, guides, site publishing"
    description={content.description}
    breadcrumbLabel="About"
    sections={content.sections}
    supportLinkLabel="Email support from this page"
    homeLinkLabel="Return to the homepage"
    absoluteBase={schemaOrigin}
    supportHref={canonicalUrl(ROUTES.support, schemaOrigin)}
    homeHref={canonicalUrl(ROUTES.home, schemaOrigin)}
  />
</BaseLayout>
