---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo, canonicalUrl } from '../config/seo';
import { ROUTES, blogPostPath } from '../utils/path';

const seo = resolvePageSeo('/about/');
import LegalPage from '../components/LegalPage.astro';
import { breadcrumbSchema, organizationSchema, webPageSchema } from '../utils/schema';

const content = t.legalPages.about;
const schemaOrigin = Astro.site ? String(Astro.site).replace(/\/$/, '') : undefined;
const shareUrl = canonicalUrl('/about/', schemaOrigin);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  sharePageUrl={shareUrl}
  sharePageTitle={seo.title}
  jsonLd={[
    organizationSchema(schemaOrigin),
    webPageSchema({
      name: 'About COD Cheats — tiers, guides, site publishing',
      description: content.description,
      url: '/about/',
      origin: schemaOrigin,
    }),
    breadcrumbSchema(
      [
        { name: 'Home', path: '/' },
        { name: 'About', path: '/about/' },
      ],
      schemaOrigin,
    ),
  ]}
>
  <div class="sr-only" aria-label="Related site pages">
    <a href={ROUTES.home}>Site homepage overview</a>
    <a href={ROUTES.blog}>Blog — MW4 guides listing</a>
    <a href={blogPostPath('mw4-lite-vs-pro')}>Article — Lite vs Pro tier comparison</a>
    <a href={ROUTES.privacy}>Policy — analytics and messages</a>
    <a href={ROUTES.faq}>Help center FAQ</a>
    <a href={ROUTES.support}>Support — loader and orders</a>
  </div>
  <LegalPage
    title={content.title}
    pageTitle="About COD Cheats — tiers, guides, site publishing"
    description={content.description}
    breadcrumbLabel="About"
    sections={content.sections}
    supportLinkLabel="Email support from this page"
    homeLinkLabel="Return to the homepage"
  />
</BaseLayout>
