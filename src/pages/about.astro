---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo, canonicalUrl, resolveDocumentOrigin } from '../config/seo';
import { ROUTES, blogPostPath } from '../utils/path';

const seo = resolvePageSeo('/about/');
import LegalPage from '../components/LegalPage.astro';
import { breadcrumbSchema, organizationSchema, webPageSchema } from '../utils/schema';

const content = t.legalPages.about;
const schemaOrigin = resolveDocumentOrigin(Astro.site);
const shareUrl = canonicalUrl('/about/', schemaOrigin);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  sharePageUrl={shareUrl}
  sharePageTitle={seo.title}
  jsonLd={[
    organizationSchema(schemaOrigin),
    webPageSchema({
      name: 'About COD Cheats — tiers, guides, site publishing',
      description: content.description,
      url: '/about/',
      origin: schemaOrigin,
    }),
    breadcrumbSchema(
      [
        { name: 'Home', path: '/' },
        { name: 'About', path: '/about/' },
      ],
      schemaOrigin,
    ),
  ]}
>
  <div class="sr-only" aria-label="Related site pages">
    <a href={canonicalUrl(ROUTES.home, schemaOrigin)}>Front door — landing overview</a>
    <a href={canonicalUrl(ROUTES.blog, schemaOrigin)}>MW4 article index (all tags)</a>
    <a href={canonicalUrl(blogPostPath('mw4-lite-vs-pro'), schemaOrigin)}>Tier compare — Lite vs Pro writeup</a>
    <a href={canonicalUrl(ROUTES.privacy, schemaOrigin)}>Privacy notice — cookies and email</a>
    <a href={canonicalUrl(ROUTES.faq, schemaOrigin)}>FAQ index — products and checkout</a>
    <a href={canonicalUrl(ROUTES.support, schemaOrigin)}>Support desk — loader and billing</a>
  </div>
  <LegalPage
    title={content.title}
    pageTitle="About COD Cheats — tiers, guides, site publishing"
    description={content.description}
    breadcrumbLabel="About"
    sections={content.sections}
    supportLinkLabel="Email support from this page"
    homeLinkLabel="Return to the homepage"
  />
</BaseLayout>
