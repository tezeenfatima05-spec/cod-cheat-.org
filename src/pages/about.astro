---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo, canonicalUrl, resolveDocumentOrigin } from '../config/seo';
import { ROUTES, blogPostPath, productPath } from '../utils/path';

const seo = resolvePageSeo('/about/');
import LegalPage from '../components/LegalPage.astro';
import { breadcrumbSchema, organizationSchema, webPageSchema } from '../utils/schema';

const content = t.legalPages.about;
const schemaOrigin = resolveDocumentOrigin(Astro.site);
const shareUrl = canonicalUrl('/about/', schemaOrigin);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  sharePageUrl={shareUrl}
  sharePageTitle={seo.title}
  jsonLd={[
    organizationSchema(schemaOrigin),
    webPageSchema({
      name: 'About COD Cheats — tiers, guides, site publishing',
      description: content.description,
      url: '/about/',
      origin: schemaOrigin,
    }),
    breadcrumbSchema(
      [
        { name: 'Home', path: '/' },
        { name: 'About', path: '/about/' },
      ],
      schemaOrigin,
    ),
  ]}
>
  <div class="sr-only" aria-label="Related site pages">
    <a href={`${schemaOrigin}/sitemap.xml`}>XML index — every indexable href</a>
    <a href={canonicalUrl(ROUTES.home, schemaOrigin)}>Landing — ZADEYO MW4 cheat overview</a>
    <a href={canonicalUrl(ROUTES.blog, schemaOrigin)}>Blog roll — newest MW4 guides first</a>
    <a href={canonicalUrl(blogPostPath('mw4-lite-vs-pro'), schemaOrigin)}>Comparison post — Lite tier vs Pro</a>
    <a href={canonicalUrl(blogPostPath('anticheat-patch-day-checklist'), schemaOrigin)}>Updates post — anticheat patch-day list</a>
    <a href={canonicalUrl(ROUTES.products, schemaOrigin)}>Catalog — tier comparison hub</a>
    <a href={canonicalUrl(productPath('elite'), schemaOrigin)}>Elite page — DMZ and radar bundle</a>
    <a href={canonicalUrl(ROUTES.forum, schemaOrigin)}>Forum demo — sample MW4 threads</a>
    <a href={canonicalUrl(ROUTES.privacy, schemaOrigin)}>Privacy — analytics and contact data</a>
    <a href={canonicalUrl(ROUTES.faq, schemaOrigin)}>FAQ hub — refunds and keys</a>
    <a href={canonicalUrl(ROUTES.support, schemaOrigin)}>Support — email for loader issues</a>
    <a href={canonicalUrl(ROUTES.terms, schemaOrigin)}>Terms — purchase and refund policy</a>
  </div>
  <LegalPage
    title={content.title}
    pageTitle="About COD Cheats — tiers, guides, site publishing"
    description={content.description}
    breadcrumbLabel="About"
    sections={content.sections}
    supportLinkLabel="Email support from this page"
    homeLinkLabel="Return to the homepage"
    absoluteBase={schemaOrigin}
    supportHref={canonicalUrl(ROUTES.support, schemaOrigin)}
    homeHref={canonicalUrl(ROUTES.home, schemaOrigin)}
  />
</BaseLayout>
