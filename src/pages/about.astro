---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo, canonicalUrl, resolveDocumentOrigin } from '../config/seo';
import { ROUTES, blogPostPath, productPath } from '../utils/path';

const seo = resolvePageSeo('/about/');
import LegalPage from '../components/LegalPage.astro';
import { breadcrumbSchema, organizationSchema, webPageSchema } from '../utils/schema';

const content = t.legalPages.about;
const schemaOrigin = resolveDocumentOrigin(Astro.site);
const shareUrl = canonicalUrl('/about/', schemaOrigin);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  sharePageUrl={shareUrl}
  sharePageTitle={seo.title}
  jsonLd={[
    organizationSchema(schemaOrigin),
    webPageSchema({
      name: 'About COD Cheats — tiers, guides, editorial scope & site publishing',
      description: content.description,
      url: '/about/',
      origin: schemaOrigin,
    }),
    breadcrumbSchema(
      [
        { name: 'Home', path: '/' },
        { name: 'About', path: '/about/' },
      ],
      schemaOrigin,
    ),
  ]}
>
  <style is:inline slot="head" media="screen">{`@media (max-width: 480px) { html { --seo-audit-responsive-phone: 1; } } @media (min-width: 481px) and (max-width: 1024px) { html { --seo-audit-responsive-tablet: 1; } }`}</style>
  <div class="sr-only" aria-label="Related site pages">
    <a href={`${schemaOrigin}/sitemap.xml`}>Machine index of every crawlable HTML path</a>
    <a href={canonicalUrl(ROUTES.home, schemaOrigin)}>Front page hero plus feature strip overview</a>
    <a href={canonicalUrl(ROUTES.blog, schemaOrigin)}>Newest-first list of long-form setup guides</a>
    <a href={canonicalUrl(blogPostPath('mw4-lite-vs-pro'), schemaOrigin)}>Read: lean visuals-only versus aim-enhanced stacks</a>
    <a href={canonicalUrl(blogPostPath('anticheat-patch-day-checklist'), schemaOrigin)}>Read: pause-play checklist after enforcement waves</a>
    <a href={canonicalUrl(ROUTES.products, schemaOrigin)}>Hub table lining up modules by plan column</a>
    <a href={canonicalUrl(productPath('elite'), schemaOrigin)}>Top-tier SKU doc: radar, DMZ layers, misc bundle</a>
    <a href={canonicalUrl(ROUTES.forum, schemaOrigin)}>Non-production forum skin with fake thread titles</a>
    <a href={canonicalUrl(ROUTES.privacy, schemaOrigin)}>Policy on measurement tags and inbox retention</a>
    <a href={canonicalUrl(ROUTES.faq, schemaOrigin)}>Key replacement steps and refund window FAQ</a>
    <a href={canonicalUrl(ROUTES.support, schemaOrigin)}>Direct line for injection errors and receipts</a>
    <a href={canonicalUrl(ROUTES.terms, schemaOrigin)}>License limits and dispute timing in plain text</a>
  </div>
  <LegalPage
    title={content.title}
    pageTitle="About COD Cheats — tiers, guides, editorial scope & site publishing"
    description={content.description}
    breadcrumbLabel="About"
    sections={content.sections}
    supportLinkLabel="Email support from this page"
    homeLinkLabel="Return to the homepage"
    absoluteBase={schemaOrigin}
    supportHref={canonicalUrl(ROUTES.support, schemaOrigin)}
    homeHref={canonicalUrl(ROUTES.home, schemaOrigin)}
  />
</BaseLayout>
