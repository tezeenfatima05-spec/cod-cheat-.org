---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo, canonicalUrl, resolveDocumentOrigin } from '../config/seo';
import { ROUTES, blogPostPath, productPath } from '../utils/path';

const seo = resolvePageSeo('/about/');
import LegalPage from '../components/LegalPage.astro';
import { breadcrumbSchema, organizationSchema, webPageSchema } from '../utils/schema';

const content = t.legalPages.about;
const schemaOrigin = resolveDocumentOrigin(Astro.site);
const shareUrl = canonicalUrl('/about/', schemaOrigin);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  sharePageUrl={shareUrl}
  sharePageTitle={seo.title}
  jsonLd={[
    organizationSchema(schemaOrigin),
    webPageSchema({
      name: 'About COD Cheats — tiers, guides, site publishing',
      description: content.description,
      url: '/about/',
      origin: schemaOrigin,
    }),
    breadcrumbSchema(
      [
        { name: 'Home', path: '/' },
        { name: 'About', path: '/about/' },
      ],
      schemaOrigin,
    ),
  ]}
>
  <div class="sr-only" aria-label="Related site pages">
    <a href={`${schemaOrigin}/sitemap.xml`}>XML sitemap listing all indexable paths</a>
    <a href={canonicalUrl(ROUTES.home, schemaOrigin)}>Homepage MW4 cheat positioning summary</a>
    <a href={canonicalUrl(ROUTES.blog, schemaOrigin)}>Blog index (newest MW4 guides at top)</a>
    <a href={canonicalUrl(blogPostPath('mw4-lite-vs-pro'), schemaOrigin)}>Lite vs Pro tier comparison article</a>
    <a href={canonicalUrl(blogPostPath('anticheat-patch-day-checklist'), schemaOrigin)}>Anticheat patch-day checklist article</a>
    <a href={canonicalUrl(ROUTES.products, schemaOrigin)}>Product hub with tier comparison table</a>
    <a href={canonicalUrl(productPath('elite'), schemaOrigin)}>Elite SKU page (DMZ plus radar bundle)</a>
    <a href={canonicalUrl(ROUTES.forum, schemaOrigin)}>Forum demo with sample MW4 threads</a>
    <a href={canonicalUrl(ROUTES.privacy, schemaOrigin)}>Privacy overview on analytics and contact data</a>
    <a href={canonicalUrl(ROUTES.faq, schemaOrigin)}>FAQ index covering refunds and license keys</a>
    <a href={canonicalUrl(ROUTES.support, schemaOrigin)}>Support contact for loaders and orders</a>
    <a href={canonicalUrl(ROUTES.terms, schemaOrigin)}>Terms covering purchases and refund policy</a>
  </div>
  <LegalPage
    title={content.title}
    pageTitle="About COD Cheats — tiers, guides, site publishing"
    description={content.description}
    breadcrumbLabel="About"
    sections={content.sections}
    supportLinkLabel="Email support from this page"
    homeLinkLabel="Return to the homepage"
    absoluteBase={schemaOrigin}
    supportHref={canonicalUrl(ROUTES.support, schemaOrigin)}
    homeHref={canonicalUrl(ROUTES.home, schemaOrigin)}
  />
</BaseLayout>
