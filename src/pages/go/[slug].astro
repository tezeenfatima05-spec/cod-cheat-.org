---
import type { GetStaticPaths } from 'astro';
import { CHECKOUT, CHECKOUT_SLUG_TO_PRODUCT } from '../../config/checkout';
import {
  absoluteAssetUrl,
  canonicalUrl,
  resolveDocumentOrigin,
  DEFAULT_OG_IMAGE_HEIGHT,
  DEFAULT_OG_IMAGE_WIDTH,
} from '../../config/seo';
import { SITE_ASSETS } from '../../config/site';
import { ROUTES } from '../../utils/path';

export const prerender = true;

export const getStaticPaths: GetStaticPaths = () =>
  Object.keys(CHECKOUT_SLUG_TO_PRODUCT).map((slug) => ({ params: { slug } }));

const { slug } = Astro.params;
const product = CHECKOUT_SLUG_TO_PRODUCT[slug!];
const destination = product ? CHECKOUT[product] : '/';

const selfPath = `/go/${slug}/`;
const siteOriginTrim = resolveDocumentOrigin(Astro.site);
const selfCanonical = canonicalUrl(selfPath, siteOriginTrim);

const isMw4 = slug === 'mw4';
const docTitle = isMw4
  ? 'Go Tazeen To 2fproducts 2fmw4 – Redirecting from /go/mw4/ to'
  : `Redirecting to checkout (${slug})`;
const metaDesc = isMw4
  ? 'Go Tazeen To 2fproducts 2fmw4: Redirecting from /go/mw4/ to https://zadeyo.com/go/TAZEEN?to=%2Fproducts%2Fmw4. Go Tazeen To 2fproducts 2fmw4 You are.'
  : `This page forwards you to the secure checkout for ${slug?.replace(/-/g, ' ') ?? 'the selected product'}.`;
const h1Text = isMw4 ? 'Go Tazeen To 2fproducts 2fmw4 — redirecting' : docTitle;

const shareUrl = selfCanonical;
const xShare = `https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(docTitle)}`;
const facebookShare = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`;

const ogImagePath = SITE_ASSETS.ogImage;
const ogImageUrl = absoluteAssetUrl(ogImagePath, siteOriginTrim);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: docTitle,
  description: metaDesc,
  url: selfCanonical,
  inLanguage: 'en-US',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{docTitle}</title>
    <meta name="description" content={metaDesc} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={selfCanonical} />
    <link rel="alternate" hreflang="en" href={selfCanonical} />
    <link rel="alternate" hreflang="en-US" href={selfCanonical} />
    <link rel="alternate" hreflang="en-GB" href={selfCanonical} />
    <link rel="alternate" hreflang="en-CA" href={selfCanonical} />
    <link rel="alternate" hreflang="en-AU" href={selfCanonical} />
    <link rel="alternate" hreflang="en-NZ" href={selfCanonical} />
    <link rel="alternate" hreflang="en-IN" href={selfCanonical} />
    <link rel="alternate" hreflang="en-SG" href={selfCanonical} />
    <link rel="alternate" hreflang="en-IE" href={selfCanonical} />
    <link rel="alternate" hreflang="en-ZA" href={selfCanonical} />
    <link rel="alternate" hreflang="x-default" href={selfCanonical} />
    <meta property="og:title" content={docTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={selfCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="COD Cheats" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="en_GB" />
    <meta property="og:locale:alternate" content="en_CA" />
    <meta property="og:locale:alternate" content="en_AU" />
    <meta property="og:locale:alternate" content="en_NZ" />
    <meta property="og:locale:alternate" content="en_IN" />
    <meta property="og:locale:alternate" content="en_SG" />
    <meta property="og:locale:alternate" content="en_IE" />
    <meta property="og:locale:alternate" content="en_ZA" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content={docTitle} />
    <meta property="og:image:width" content={String(DEFAULT_OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(DEFAULT_OG_IMAGE_HEIGHT)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={docTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style>
      @media (max-width: 639px) {
        main {
          padding-left: 1rem;
          padding-right: 1rem;
        }
      }
      @media (min-width: 640px) and (max-width: 1023px) {
        main {
          max-width: 40rem;
          margin-left: auto;
          margin-right: auto;
        }
      }
    </style>
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <script is:inline set:html={`location.replace(${JSON.stringify(destination)})`} />
  </head>
  <body>
    <h1>{h1Text}</h1>
    <main>
      <h2>Secure checkout handoff</h2>
      <p>
        You are leaving this site for a hosted checkout page. Most browsers follow the redirect immediately; if not,
        use the link below.
      </p>
      <p>
        <a href={destination}>Continue to checkout</a>
      </p>
      {isMw4 && (
        <figure style="margin:1rem 0">
          <img
            src="/images/mw4/screenshot-1.webp"
            alt="MW4 module preview — related to COD MW4 checkout"
            width="640"
            height="360"
            loading="lazy"
            decoding="async"
          />
        </figure>
      )}
      <h2>More on this site</h2>
      <p>
        <a href={ROUTES.products}>MW4 product overview</a>
        {' · '}
        <a href={ROUTES.blog}>Setup and patch guides</a>
        {' · '}
        <a href={ROUTES.faq}>FAQ on tiers and checkout</a>
      </p>
      {isMw4 && (
        <>
          <p>
            This shortcut exists so in-product links can stay short while the destination URL carries the full product path
            on the partner site. Crawlers still see this HTML before the browser follows the redirect.
          </p>
          <p>
            Before you leave, confirm you are on Windows 10 or 11 with current GPU drivers—most MW4 loader issues come from outdated
            vendor stacks or aggressive antivirus hooks that block unsigned modules.
          </p>
          <p>
            After checkout, your operator email is the recovery line: keep it out of public chats, use a mailbox you control, and
            whitelist incoming mail from the partner host so portal links do not land in spam.
          </p>
          <p>
            If you recently changed hardware, open the Support route and note your tier before requesting a portal reset—HWID
            limits vary by plan, and the team needs your order reference to align the right policy.
          </p>
          <p>
            Large title updates often pause public status briefly. When that happens, load a private lobby with overlays off,
            install the newest portal build from your account, then retest one module at a time instead of stacking changes.
          </p>
          <p>
            If your session blocks automatic redirects, copy the destination URL manually or return to the product page and use
            the primary call-to-action there. Bookmark this page only if your workflow relies on the internal shortcut.
          </p>
          <p>
            Support questions about access or loader behavior belong on the Support route; this redirect does not collect
            payment details—the partner host handles checkout and receipts.
          </p>
          <p>
            Keep this URL off public listings if you only need a personal bookmark; search engines may still index it when
            linked openly. The partner checkout page may set its own cookies and analytics independent of this domain.
          </p>
          <p>
            For module scope before you pay, review the product comparison on this site so expectations match the tier you select
            during checkout.
          </p>
        </>
      )}
      <p>
        Prefer sharing this shortcut? Use
        <a href={xShare}>X (Twitter)</a>
        {' or '}
        <a href={facebookShare}>Facebook</a>
        .
      </p>
    </main>
  </body>
</html>
