---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { t } from '../i18n';
import { resolvePageSeo, canonicalUrl, resolveDocumentOrigin } from '../config/seo';
import { ROUTES, blogPostPath, productPath } from '../utils/path';
import { checkoutPath } from '../config/checkout';
import { faqPageSchema, homeWebPageSchema, organizationSchema, websiteSchema } from '../utils/schema';
import { getHomeLandingFaqs } from '../data/faq';
import { webpSrc } from '../utils/responsiveImage';
import { SITE_ASSETS } from '../config/site';

const seo = resolvePageSeo('/');
const heroLcpImage = webpSrc(SITE_ASSETS.heroPoster, 512);
const schemaOrigin = resolveDocumentOrigin(Astro.site);
const homeFaqs = getHomeLandingFaqs(schemaOrigin);
const shareUrl = canonicalUrl('/', schemaOrigin);
---

<BaseLayout
  title={seo.title}
  seoExactTitle
  description={seo.description}
  sharePageUrl={shareUrl}
  sharePageTitle={seo.title}
  minimalHeadSocialSrLinks
  trimOgLocales
  omitBodySitemapLink
  linkAbsoluteBase={schemaOrigin}
  jsonLd={[
    websiteSchema(schemaOrigin),
    organizationSchema(schemaOrigin),
    homeWebPageSchema({ name: seo.title, description: seo.description, origin: schemaOrigin }),
    faqPageSchema(
      homeFaqs.map((f, i) => ({
        num: String(i + 1).padStart(2, '0'),
        q: f.q,
        a: f.a.replace(/<[^>]+>/g, ''),
      })),
    ),
  ]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <div class="sr-only" aria-label="Site shortcuts">
    <a href={`${schemaOrigin}/sitemap.xml`}>Machine-readable sitemap index (XML)</a>
    <a href={canonicalUrl(ROUTES.products, schemaOrigin)}>MW4 PC cheat tier comparison hub</a>
    <a href={canonicalUrl(ROUTES.blog, schemaOrigin)}>Patch-day setup guides — blog index</a>
    <a href={canonicalUrl(ROUTES.forum, schemaOrigin)}>Demo forum — sample discussion layout</a>
    <a href={canonicalUrl(ROUTES.faq, schemaOrigin)}>Loader and checkout questions — FAQ hub</a>
    <a href={canonicalUrl(checkoutPath('mw4'), schemaOrigin)}>Partner checkout handoff — /go/mw4/</a>
    <a href={canonicalUrl(ROUTES.about, schemaOrigin)}>Editorial scope — how MW4 posts are written</a>
    <a href={canonicalUrl(ROUTES.privacy, schemaOrigin)}>Privacy policy — cookies and contact email</a>
    <a href={canonicalUrl(ROUTES.terms, schemaOrigin)}>License terms — refunds and usage</a>
    <a href={canonicalUrl(`${ROUTES.blog}mw4-stream-proof-setup/`, schemaOrigin)}>
      MW4 stream-proof guide — OBS capture steps
    </a>
    <a href={canonicalUrl(blogPostPath('mw4-lite-vs-pro'), schemaOrigin)}>Lite vs Pro — tier comparison article</a>
    <a href={canonicalUrl(blogPostPath('mw4-elite-tier-guide'), schemaOrigin)}>Elite tier guide — radar and DMZ stack</a>
    <a href={canonicalUrl(ROUTES.productsElite, schemaOrigin)}>Elite product page — module matrix</a>
    <a href={canonicalUrl(productPath('lite'), schemaOrigin)}>Lite product page — visuals-first stack</a>
    <a href={canonicalUrl(productPath('pro'), schemaOrigin)}>Pro product page — aim and trigger stack</a>
    <a href={canonicalUrl(ROUTES.productsUtilities, schemaOrigin)}>Utilities hub — skin preview and UGC tools</a>
  </div>
  <HeroSection
    productsSrHref={canonicalUrl(ROUTES.products, schemaOrigin)}
    heroTitleOverride="COD Cheats for PC — aimbot, player ESP & wallhack — catalog hero destination"
  />
  <FeaturesSection />
  <ProductsSection linkBase={schemaOrigin} />
  <WhySetupSection />
  <ContentSections faqItems={homeFaqs} blogCtaHref={canonicalUrl(ROUTES.blog, schemaOrigin)} />
</BaseLayout>
