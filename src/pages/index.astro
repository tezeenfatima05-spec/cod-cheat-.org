---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { t } from '../i18n';
import { resolvePageSeo, canonicalUrl, resolveDocumentOrigin } from '../config/seo';
import { ROUTES, blogPostPath, productPath } from '../utils/path';
import { checkoutPath } from '../config/checkout';
import { faqPageSchema, homeWebPageSchema, organizationSchema, websiteSchema } from '../utils/schema';
import { getHomeLandingFaqs } from '../data/faq';
import { webpSrc } from '../utils/responsiveImage';
import { SITE_ASSETS } from '../config/site';

const seo = resolvePageSeo('/');
const heroLcpImage = webpSrc(SITE_ASSETS.heroPoster, 512);
const schemaOrigin = resolveDocumentOrigin(Astro.site);
const homeFaqs = getHomeLandingFaqs(schemaOrigin);
const shareUrl = canonicalUrl('/', schemaOrigin);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  sharePageUrl={shareUrl}
  sharePageTitle={seo.title}
  minimalHeadSocialSrLinks
  omitBodySitemapLink
  linkAbsoluteBase={schemaOrigin}
  jsonLd={[
    websiteSchema(schemaOrigin),
    organizationSchema(schemaOrigin),
    homeWebPageSchema({ name: seo.title, description: seo.description, origin: schemaOrigin }),
    faqPageSchema(
      homeFaqs.map((f, i) => ({
        num: String(i + 1).padStart(2, '0'),
        q: f.q,
        a: f.a.replace(/<[^>]+>/g, ''),
      })),
    ),
  ]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <div class="sr-only" aria-label="Site shortcuts">
    <a href={`${schemaOrigin}/sitemap.xml`}>Machine-readable sitemap — URL list (XML)</a>
    <a href={canonicalUrl(ROUTES.products, schemaOrigin)}>Product lineup — compare MW4 PC cheat tiers</a>
    <a href={canonicalUrl(ROUTES.blog, schemaOrigin)}>Editorial archive — MW4 setup and patch writeups</a>
    <a href={canonicalUrl(ROUTES.forum, schemaOrigin)}>Sample community threads (demo forum)</a>
    <a href={canonicalUrl(ROUTES.faq, schemaOrigin)}>Help center — tiers, loader, and checkout</a>
    <a href={canonicalUrl(checkoutPath('mw4'), schemaOrigin)}>Paid checkout shortcut — /go/mw4/ handoff</a>
    <a href={canonicalUrl(ROUTES.about, schemaOrigin)}>Editorial scope — how guides are written</a>
    <a href={canonicalUrl(ROUTES.privacy, schemaOrigin)}>Privacy statement — analytics and email</a>
    <a href={canonicalUrl(ROUTES.terms, schemaOrigin)}>Terms of purchase — license and refunds</a>
    <a href={canonicalUrl(`${ROUTES.blog}mw4-stream-proof-setup/`, schemaOrigin)}>
      OBS capture modes — stream overlay walkthrough
    </a>
    <a href={canonicalUrl(blogPostPath('mw4-lite-vs-pro'), schemaOrigin)}>Tier choice guide — Lite vs Pro comparison</a>
    <a href={canonicalUrl(blogPostPath('mw4-elite-tier-guide'), schemaOrigin)}>Elite tier guide — full module stack</a>
    <a href={canonicalUrl(ROUTES.productsElite, schemaOrigin)}>Elite product page — radar and DMZ modules</a>
    <a href={canonicalUrl(productPath('lite'), schemaOrigin)}>Lite tier page — ESP-first module list</a>
    <a href={canonicalUrl(productPath('pro'), schemaOrigin)}>Pro tier page — aim and trigger modules</a>
    <a href={canonicalUrl(ROUTES.productsUtilities, schemaOrigin)}>Utilities hub — UGC and related tools</a>
  </div>
  <HeroSection productsSrHref={canonicalUrl(ROUTES.products, schemaOrigin)} />
  <FeaturesSection />
  <ProductsSection linkBase={schemaOrigin} />
  <WhySetupSection />
  <ContentSections faqItems={homeFaqs} blogCtaHref={canonicalUrl(ROUTES.blog, schemaOrigin)} />
</BaseLayout>
