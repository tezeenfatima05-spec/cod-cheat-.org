---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { t } from '../i18n';
import { resolvePageSeo, canonicalUrl, resolveDocumentOrigin } from '../config/seo';
import { ROUTES, blogPostPath, productPath } from '../utils/path';
import { checkoutPath } from '../config/checkout';
import { faqPageSchema, homeWebPageSchema, organizationSchema, websiteSchema } from '../utils/schema';
import { getHomeLandingFaqs } from '../data/faq';
import { webpSrc } from '../utils/responsiveImage';
import { SITE_ASSETS } from '../config/site';

const seo = resolvePageSeo('/');
const heroLcpImage = webpSrc(SITE_ASSETS.heroPoster, 512);
const schemaOrigin = resolveDocumentOrigin(Astro.site);
const homeFaqs = getHomeLandingFaqs(schemaOrigin);
const shareUrl = canonicalUrl('/', schemaOrigin);
---

<BaseLayout
  title={seo.title}
  seoExactTitle
  description={seo.description}
  sharePageUrl={shareUrl}
  sharePageTitle={seo.title}
  trimOgLocales
  omitBodySitemapLink
  linkAbsoluteBase={schemaOrigin}
  jsonLd={[
    websiteSchema(schemaOrigin),
    organizationSchema(schemaOrigin),
    homeWebPageSchema({ name: seo.title, description: seo.description, origin: schemaOrigin }),
    faqPageSchema(
      homeFaqs.map((f, i) => ({
        num: String(i + 1).padStart(2, '0'),
        q: f.q,
        a: f.a.replace(/<[^>]+>/g, ''),
      })),
    ),
  ]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <div class="sr-only" aria-label="Site shortcuts">
    <a href={`${schemaOrigin}/sitemap.xml`}>Crawlable URL manifest (application/xml)</a>
    <a href={canonicalUrl(ROUTES.products, schemaOrigin)}>Compare Lite Pro Elite on the MW4 catalog</a>
    <a href={canonicalUrl(ROUTES.blog, schemaOrigin)}>Chronological MW4 guides and patch writeups</a>
    <a href={canonicalUrl(ROUTES.forum, schemaOrigin)}>Demo-only forum thread index</a>
    <a href={canonicalUrl(ROUTES.faq, schemaOrigin)}>Billing HWID and refund topics (FAQ)</a>
    <a href={canonicalUrl(checkoutPath('mw4'), schemaOrigin)}>External partner route: /go/mw4/ checkout</a>
    <a href={canonicalUrl(ROUTES.about, schemaOrigin)}>Site editorial scope for MW4 coverage</a>
    <a href={canonicalUrl(ROUTES.privacy, schemaOrigin)}>Analytics cookies and support email policy</a>
    <a href={canonicalUrl(ROUTES.terms, schemaOrigin)}>Digital license purchase and refund wording</a>
    <a href={canonicalUrl(ROUTES.support, schemaOrigin)}>Direct help desk for loaders and orders</a>
    <a href={canonicalUrl(`${ROUTES.blog}mw4-stream-proof-setup/`, schemaOrigin)}>
      Stream-overlay OBS checklist (capture-safe)
    </a>
    <a href={canonicalUrl(blogPostPath('mw4-lite-vs-pro'), schemaOrigin)}>Article: Lite tier vs Pro modules</a>
    <a href={canonicalUrl(blogPostPath('mw4-elite-tier-guide'), schemaOrigin)}>Article: Elite radar plus DMZ bundle</a>
    <a href={canonicalUrl(ROUTES.productsElite, schemaOrigin)}>SKU detail: Elite full feature column</a>
    <a href={canonicalUrl(productPath('lite'), schemaOrigin)}>SKU detail: Lite ESP-first modules</a>
    <a href={canonicalUrl(productPath('pro'), schemaOrigin)}>SKU detail: Pro aim and trigger add-ons</a>
    <a href={canonicalUrl(ROUTES.productsUtilities, schemaOrigin)}>Cosmetic and UGC utility index page</a>
  </div>
  <HeroSection productsSrHref={canonicalUrl(ROUTES.products, schemaOrigin)} />
  <FeaturesSection />
  <ProductsSection linkBase={schemaOrigin} />
  <WhySetupSection />
  <ContentSections faqItems={homeFaqs} blogCtaHref={canonicalUrl(ROUTES.blog, schemaOrigin)} />
</BaseLayout>
