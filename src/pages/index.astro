---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { t } from '../i18n';
import { resolvePageSeo, canonicalUrl, resolveDocumentOrigin } from '../config/seo';
import { ROUTES, blogPostPath, productPath } from '../utils/path';
import { checkoutPath } from '../config/checkout';
import { faqPageSchema, homeWebPageSchema, organizationSchema, websiteSchema } from '../utils/schema';
import { getHomeLandingFaqs } from '../data/faq';
import { webpSrc } from '../utils/responsiveImage';
import { SITE_ASSETS } from '../config/site';

const seo = resolvePageSeo('/');
const heroLcpImage = webpSrc(SITE_ASSETS.heroPoster, 512);
const schemaOrigin = resolveDocumentOrigin(Astro.site);
const homeFaqs = getHomeLandingFaqs(schemaOrigin);
const shareUrl = canonicalUrl('/', schemaOrigin);
---

<BaseLayout
  title={seo.title}
  seoExactTitle
  description={seo.description}
  sharePageUrl={shareUrl}
  sharePageTitle={seo.title}
  trimOgLocales
  heavyHeadTrim
  minimalHeadSocialSrLinks
  omitBodySitemapLink
  linkAbsoluteBase={schemaOrigin}
  jsonLd={[
    websiteSchema(schemaOrigin),
    organizationSchema(schemaOrigin),
    homeWebPageSchema({ name: seo.title, description: seo.description, origin: schemaOrigin }),
    faqPageSchema(
      homeFaqs.map((f, i) => ({
        num: String(i + 1).padStart(2, '0'),
        q: f.q,
        a: f.a.replace(/<[^>]+>/g, ''),
      })),
    ),
  ]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <div class="sr-only" aria-label="Site shortcuts">
    <a href={`${schemaOrigin}/sitemap.xml`}>XML crawl manifest listing every public route</a>
    <a href={canonicalUrl(ROUTES.products, schemaOrigin)}>
      MW4 cheat tiers — Lite, Pro, and Elite catalog grid (single hub link)
    </a>
    <a href={canonicalUrl(ROUTES.blog, schemaOrigin)}>Chronological writeups on loaders, patches, and tuning</a>
    <a href={canonicalUrl(ROUTES.forum, schemaOrigin)}>Mock forum shell showing example discussion titles only</a>
    <a href={canonicalUrl(ROUTES.faq, schemaOrigin)}>Answers on key resets, chargebacks, and hardware IDs</a>
    <a href={canonicalUrl(checkoutPath('mw4'), schemaOrigin)}>Brief same-origin redirect before hosted payment form</a>
    <a href={canonicalUrl(ROUTES.about, schemaOrigin)}>Scope note: multiplayer overlay documentation only</a>
    <a href={canonicalUrl(ROUTES.privacy, schemaOrigin)}>How analytics tags behave and how support mail is stored</a>
    <a href={canonicalUrl(ROUTES.terms, schemaOrigin)}>Contract text covering digital goods and dispute windows</a>
    <a href={canonicalUrl(ROUTES.support, schemaOrigin)}>Mailbox path for stuck injections or order receipts</a>
    <a href={canonicalUrl(`${ROUTES.blog}mw4-stream-proof-setup/`, schemaOrigin)}>
      Stream-recording hygiene: mask capture without leaking HUD
    </a>
    <a href={canonicalUrl(blogPostPath('mw4-lite-vs-pro'), schemaOrigin)}>
      Visual-first build compared with aim-assist add-ons explained
    </a>
    <a href={canonicalUrl(blogPostPath('mw4-elite-tier-guide'), schemaOrigin)}>
      Wide radar sweep paired with extraction-mode loot highlights
    </a>
    <a href={canonicalUrl(ROUTES.productsElite, schemaOrigin)}>Single destination for every module class on the top build</a>
    <a href={canonicalUrl(productPath('lite'), schemaOrigin)}>Corner boxes, skeleton draw, snapline distance ceilings</a>
    <a href={canonicalUrl(productPath('pro'), schemaOrigin)}>Crosshair gate delay plus arming key for burst sprays</a>
    <a href={canonicalUrl(ROUTES.productsUtilities, schemaOrigin)}>Cosmetic swaps and account-side extras in one index</a>
  </div>
  <HeroSection
    productsSrHref={canonicalUrl(ROUTES.products, schemaOrigin)}
    heroTitleOverride="cod cheats for pc aimbot player esp wallhack — COD MW4"
  />
  <FeaturesSection />
  <ProductsSection linkBase={schemaOrigin} />
  <WhySetupSection />
  <ContentSections faqItems={homeFaqs} blogCtaHref={canonicalUrl(ROUTES.blog, schemaOrigin)} />
</BaseLayout>
