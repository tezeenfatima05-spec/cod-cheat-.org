---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { t } from '../i18n';
import { resolvePageSeo, canonicalUrl } from '../config/seo';
import { ROUTES } from '../utils/path';
import { checkoutPath } from '../config/checkout';
import { faqPageSchema, organizationSchema, websiteSchema } from '../utils/schema';
import { getLandingFaqs } from '../data/faq';
import { webpSrc } from '../utils/responsiveImage';
import { SITE_ASSETS } from '../config/site';

const seo = resolvePageSeo('/');
const homeFaqs = getLandingFaqs();
const heroLcpImage = webpSrc(SITE_ASSETS.heroPoster, 512);
const shareUrl = canonicalUrl('/');
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  sharePageUrl={shareUrl}
  sharePageTitle={seo.title}
  jsonLd={[websiteSchema(), organizationSchema(), faqPageSchema(homeFaqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') })))]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <div class="sr-only" aria-label="Site shortcuts">
    <a href={ROUTES.products}>MW4 cheat tiers and product hub</a>
    <a href={ROUTES.blog}>MW4 guides and patch notes index</a>
    <a href={ROUTES.forum}>Demo community threads index</a>
    <a href={ROUTES.faq}>FAQ on checkout and module tiers</a>
    <a href={checkoutPath('mw4')}>Short checkout path /go/mw4/</a>
  </div>
  <HeroSection />
  <FeaturesSection />
  <ProductsSection />
  <WhySetupSection />
  <ContentSections />
</BaseLayout>
