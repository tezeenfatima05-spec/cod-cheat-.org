---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { t } from '../i18n';
import { resolvePageSeo, canonicalUrl, resolveDocumentOrigin } from '../config/seo';
import { ROUTES, blogPostPath, productPath } from '../utils/path';
import { checkoutPath } from '../config/checkout';
import { faqPageSchema, homeWebPageSchema, organizationSchema, websiteSchema } from '../utils/schema';
import { getHomeLandingFaqs } from '../data/faq';
import { webpSrc } from '../utils/responsiveImage';
import { SITE_ASSETS } from '../config/site';

const seo = resolvePageSeo('/');
const heroLcpImage = webpSrc(SITE_ASSETS.heroPoster, 512);
const schemaOrigin = resolveDocumentOrigin(Astro.site);
const homeFaqs = getHomeLandingFaqs(schemaOrigin);
const shareUrl = canonicalUrl('/', schemaOrigin);
---

<BaseLayout
  title={seo.title}
  seoExactTitle
  description={seo.description}
  sharePageUrl={shareUrl}
  sharePageTitle={seo.title}
  trimOgLocales
  heavyHeadTrim
  omitHeadSocialSrLinks
  omitBodySitemapLink
  linkAbsoluteBase={schemaOrigin}
  jsonLd={[
    websiteSchema(schemaOrigin),
    organizationSchema(schemaOrigin),
    homeWebPageSchema({ name: seo.title, description: seo.description, origin: schemaOrigin }),
    faqPageSchema(
      homeFaqs.map((f, i) => ({
        num: String(i + 1).padStart(2, '0'),
        q: f.q,
        a: f.a.replace(/<[^>]+>/g, ''),
      })),
    ),
  ]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <div class="sr-only" aria-label="Site shortcuts">
    <a href={`${schemaOrigin}/sitemap.xml`}>Machine-readable URL list (application/xml)</a>
    <a href={canonicalUrl(ROUTES.products, schemaOrigin)}>
      Side-by-side feature matrix for Lite, Pro, and Elite stacks
    </a>
    <a href={canonicalUrl(ROUTES.blog, schemaOrigin)}>Newest-first archive of patch notes and loader setup notes</a>
    <a href={canonicalUrl(ROUTES.forum, schemaOrigin)}>Sample thread titles in a non-production discussion shell</a>
    <a href={canonicalUrl(ROUTES.faq, schemaOrigin)}>HWID swaps, portal keys, and refund eligibility Q&amp;A</a>
    <a href={canonicalUrl(checkoutPath('mw4'), schemaOrigin)}>Internal /go/mw4/ hop before off-site payment</a>
    <a href={canonicalUrl(ROUTES.about, schemaOrigin)}>Editorial boundaries for MW4 module coverage here</a>
    <a href={canonicalUrl(ROUTES.privacy, schemaOrigin)}>Cookie use and what happens if you email support</a>
    <a href={canonicalUrl(ROUTES.terms, schemaOrigin)}>License grant scope and chargeback handling summary</a>
    <a href={canonicalUrl(ROUTES.support, schemaOrigin)}>Where to escalate stuck loaders or missing invoices</a>
    <a href={canonicalUrl(`${ROUTES.blog}mw4-stream-proof-setup/`, schemaOrigin)}>
      OBS capture filters that keep HUD overlays off recordings
    </a>
    <a href={canonicalUrl(blogPostPath('mw4-lite-vs-pro'), schemaOrigin)}>
      When ESP-only is enough versus adding aim smoothing
    </a>
    <a href={canonicalUrl(blogPostPath('mw4-elite-tier-guide'), schemaOrigin)}>
      Full spread: 2D radar width plus DMZ loot layer stacks
    </a>
    <a href={canonicalUrl(ROUTES.productsElite, schemaOrigin)}>Every overlay class listed on one long-form listing</a>
    <a href={canonicalUrl(productPath('lite'), schemaOrigin)}>Box styles, skeletons, and snapline caps for the entry build</a>
    <a href={canonicalUrl(productPath('pro'), schemaOrigin)}>Aim circle tuning plus hold-to-arm trigger timing notes</a>
    <a href={canonicalUrl(ROUTES.productsUtilities, schemaOrigin)}>UGC utilities and cosmetic unlock tools grouped together</a>
  </div>
  <HeroSection productsSrHref={canonicalUrl(ROUTES.products, schemaOrigin)} />
  <FeaturesSection />
  <ProductsSection linkBase={schemaOrigin} />
  <WhySetupSection />
  <ContentSections faqItems={homeFaqs} blogCtaHref={canonicalUrl(ROUTES.blog, schemaOrigin)} />
</BaseLayout>
