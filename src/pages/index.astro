---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { t } from '../i18n';
import { resolvePageSeo, canonicalUrl } from '../config/seo';
import { ROUTES } from '../utils/path';
import { checkoutPath } from '../config/checkout';
import { faqPageSchema, homeWebPageSchema, organizationSchema, websiteSchema } from '../utils/schema';
import { getLandingFaqs } from '../data/faq';
import { webpSrc } from '../utils/responsiveImage';
import { SITE_ASSETS } from '../config/site';

const seo = resolvePageSeo('/');
const homeFaqs = getLandingFaqs();
const heroLcpImage = webpSrc(SITE_ASSETS.heroPoster, 512);
const schemaOrigin = Astro.site ? String(Astro.site).replace(/\/$/, '') : undefined;
const shareUrl = canonicalUrl('/', schemaOrigin);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  sharePageUrl={shareUrl}
  sharePageTitle={seo.title}
  jsonLd={[
    websiteSchema(schemaOrigin),
    organizationSchema(schemaOrigin),
    homeWebPageSchema({ name: seo.title, description: seo.description, origin: schemaOrigin }),
    faqPageSchema(
      homeFaqs.map((f, i) => ({
        num: String(i + 1).padStart(2, '0'),
        q: f.q,
        a: f.a.replace(/<[^>]+>/g, ''),
      })),
    ),
  ]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <div class="sr-only" aria-label="Site shortcuts">
    <a href={ROUTES.products}>MW4 PC tiers — products hub</a>
    <a href={ROUTES.blog}>MW4 guides — blog archive</a>
    <a href={ROUTES.forum}>Demo forum — sample Q&amp;A threads</a>
    <a href={ROUTES.faq}>FAQ — checkout and tier questions</a>
    <a href={checkoutPath('mw4')}>Short link — /go/mw4/ checkout route</a>
    <a href={ROUTES.about}>About — how we publish guides</a>
    <a href={ROUTES.privacy}>Data &amp; cookies — policy page</a>
    <a href={ROUTES.terms}>Legal — terms of service</a>
    <a href={`${ROUTES.blog}mw4-stream-proof-setup/`}>MW4 stream-proof — OBS capture guide</a>
  </div>
  <HeroSection />
  <FeaturesSection />
  <ProductsSection />
  <WhySetupSection />
  <ContentSections />
</BaseLayout>
