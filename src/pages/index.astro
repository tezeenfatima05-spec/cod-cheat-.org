---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { t } from '../i18n';
import { resolvePageSeo, canonicalUrl } from '../config/seo';
import { ROUTES } from '../utils/path';
import { checkoutPath } from '../config/checkout';
import { faqPageSchema, homeWebPageSchema, organizationSchema, websiteSchema } from '../utils/schema';
import { getLandingFaqs } from '../data/faq';
import { webpSrc } from '../utils/responsiveImage';
import { SITE_ASSETS } from '../config/site';

const seo = resolvePageSeo('/');
const homeFaqs = getLandingFaqs();
const heroLcpImage = webpSrc(SITE_ASSETS.heroPoster, 512);
const shareUrl = canonicalUrl('/');
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  sharePageUrl={shareUrl}
  sharePageTitle={seo.title}
  jsonLd={[
    websiteSchema(),
    organizationSchema(),
    homeWebPageSchema({ name: seo.title, description: seo.description }),
    faqPageSchema(
      homeFaqs.map((f, i) => ({
        num: String(i + 1).padStart(2, '0'),
        q: f.q,
        a: f.a.replace(/<[^>]+>/g, ''),
      })),
    ),
  ]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <div class="sr-only" aria-label="Site shortcuts">
    <a href={ROUTES.products}>MW4 PC cheat tiers (catalog hub)</a>
    <a href={ROUTES.blog}>Blog: MW4 guides and patch notes</a>
    <a href={ROUTES.forum}>Forum demo (sample threads)</a>
    <a href={ROUTES.faq}>Help: checkout and module tiers FAQ</a>
    <a href={checkoutPath('mw4')}>Fast checkout: /go/mw4/</a>
    <a href={ROUTES.about}>About: editorial MW4 tier notes</a>
    <a href={ROUTES.privacy}>Privacy policy (analytics scope)</a>
    <a href={ROUTES.terms}>Terms of service (purchase rules)</a>
    <a href={`${ROUTES.blog}mw4-stream-proof-setup/`}>Guide: stream-proof capture setup</a>
  </div>
  <HeroSection />
  <FeaturesSection />
  <ProductsSection />
  <WhySetupSection />
  <ContentSections />
</BaseLayout>
