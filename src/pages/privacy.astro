---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo, canonicalUrl } from '../config/seo';
import LegalPage from '../components/LegalPage.astro';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';
import { ROUTES } from '../utils/path';

const content = t.legalPages.privacy;
const seo = resolvePageSeo('/privacy/');
const schemaOrigin = Astro.site ? String(Astro.site).replace(/\/$/, '') : undefined;
const shareUrl = canonicalUrl('/privacy/', schemaOrigin);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  sharePageUrl={shareUrl}
  sharePageTitle={seo.title}
  jsonLd={[
    webPageSchema({
      name: 'Privacy — contact: when you browse or email support (analytics, cookies & data)',
      description: content.description,
      url: '/privacy/',
      origin: schemaOrigin,
    }),
    breadcrumbSchema(
      [
        { name: 'Home', path: '/' },
        { name: 'Privacy Policy', path: '/privacy/' },
      ],
      schemaOrigin,
    ),
  ]}
>
  <div class="sr-only" aria-label="Cross-links from privacy">
    <a href={ROUTES.home}>Privacy: back to homepage</a>
    <a href={ROUTES.terms}>Privacy: read terms of service</a>
    <a href={ROUTES.about}>Privacy: read about page</a>
    <a href={ROUTES.support}>Privacy: contact support</a>
    <a href={ROUTES.faq}>Privacy: FAQ on data and accounts</a>
  </div>
  <LegalPage
    title={content.title}
    pageTitle="Privacy — contact: when you browse or email support (analytics, cookies & data)"
    description={content.description}
    breadcrumbLabel="Privacy Policy"
    sections={content.sections}
    supportLinkLabel="Reach support about privacy"
    homeLinkLabel="Back to homepage overview"
  />
</BaseLayout>
