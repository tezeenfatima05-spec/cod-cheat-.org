---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo, canonicalUrl, resolveDocumentOrigin } from '../config/seo';
import LegalPage from '../components/LegalPage.astro';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';
import { ROUTES, blogPostPath } from '../utils/path';

const content = t.legalPages.privacy;
const seo = resolvePageSeo('/privacy/');
const schemaOrigin = resolveDocumentOrigin(Astro.site);
const shareUrl = canonicalUrl('/privacy/', schemaOrigin);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  sharePageUrl={shareUrl}
  sharePageTitle={seo.title}
  jsonLd={[
    webPageSchema({
      name: 'Privacy — contact: when you browse or email support (analytics, cookies & data)',
      description: content.description,
      url: '/privacy/',
      origin: schemaOrigin,
    }),
    breadcrumbSchema(
      [
        { name: 'Home', path: '/' },
        { name: 'Privacy Policy', path: '/privacy/' },
      ],
      schemaOrigin,
    ),
  ]}
>
  <div class="sr-only" aria-label="Site navigation from privacy">
    <a href={canonicalUrl(ROUTES.home, schemaOrigin)}>Privacy context — site home</a>
    <a href={canonicalUrl(ROUTES.terms, schemaOrigin)}>Legal terms — purchase and license</a>
    <a href={canonicalUrl(ROUTES.about, schemaOrigin)}>Site mission — guides and tiers</a>
    <a href={canonicalUrl(ROUTES.support, schemaOrigin)}>Loader help — support inbox</a>
    <a href={canonicalUrl(ROUTES.faq, schemaOrigin)}>Checkout questions — FAQ index</a>
    <a href={canonicalUrl(ROUTES.blog, schemaOrigin)}>Policy-related setup reads — blog hub</a>
    <a href={canonicalUrl(blogPostPath('mw4-stream-proof-setup'), schemaOrigin)}>Capture-safe overlays — stream-proof post</a>
  </div>
  <LegalPage
    title={content.title}
    pageTitle="Privacy — contact: when you browse or email support (analytics, cookies & data)"
    description={content.description}
    breadcrumbLabel="Privacy Policy"
    sections={content.sections}
    supportLinkLabel="Reach support about privacy"
    homeLinkLabel="Back to homepage overview"
  />
</BaseLayout>
