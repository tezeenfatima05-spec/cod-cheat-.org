---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo, canonicalUrl } from '../config/seo';
import LegalPage from '../components/LegalPage.astro';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';

const content = t.legalPages.privacy;
const seo = resolvePageSeo('/privacy/');
const shareUrl = canonicalUrl('/privacy/');
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  sharePageUrl={shareUrl}
  sharePageTitle={seo.title}
  jsonLd={[
    webPageSchema({
      name: 'Privacy — analytics, cookies, contact data & this site',
      description: content.description,
      url: '/privacy/',
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Privacy Policy', path: '/privacy/' },
    ]),
  ]}
>
  <LegalPage
    title={content.title}
    pageTitle="Privacy — analytics, cookies, contact data & this site"
    description={content.description}
    breadcrumbLabel="Privacy Policy"
    sections={content.sections}
  />
</BaseLayout>
