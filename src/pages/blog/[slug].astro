---
import '../../styles/blog-pages.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import { getAllBlogSlugs, getBlogPost, getRelatedBlogPosts } from '../../data/blog';
import { pageTitle, canonicalUrl, resolveDocumentOrigin } from '../../config/seo';
import { getBlogPageSeoEntry } from '../../config/pageSeo';
import {
  articleSchema,
  breadcrumbSchema,
  parseBlogDate,
} from '../../utils/schema';
import { checkoutPath, resolveCheckoutHref } from '../../config/checkout';
import { SITE_DOMAIN } from '../../config/site';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import BlogPostTopBar from '../../components/BlogPostTopBar.astro';
import { getBlogFaqs } from '../../data/faq';
import SiteFaqSection from '../../components/SiteFaqSection.astro';
import Icon from '../../components/icons/Icon.astro';
import type { BlogBlock } from '../../data/blog';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import BlogPostCta from '../../components/BlogPostCta.astro';
import { blogPostPath, normalizeInternalPath, productPath, ROUTES } from '../../utils/path';

export function getStaticPaths() {
  return getAllBlogSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = getBlogPost(slug!);

if (!post) {
  return Astro.redirect('/blog/');
}

const postPath = `/blog/${post.slug}/`;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: post.title, path: postPath },
];

const related = getRelatedBlogPosts(post.slug, 3);

const schemaOrigin = resolveDocumentOrigin(Astro.site);

function linkify(text: string): string {
  return text
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, label: string, href: string) => {
      if (href.startsWith('http://') || href.startsWith('https://')) {
        return `<a href="${href}">${label}</a>`;
      }
      const normalized = normalizeInternalPath(href);
      const hrefOut = canonicalUrl(normalized, schemaOrigin);
      return `<a href="${hrefOut}">${label}</a>`;
    })
    .replace(new RegExp(`(https://${SITE_DOMAIN.replace(/\./g, '\\.')}[^\\s.,;)]*)`, 'g'), (_match, url: string) => {
      const path = url.replace(new RegExp(`^https://${SITE_DOMAIN.replace(/\./g, '\\.')}`), '');
      const normalized = normalizeInternalPath(path);
      const hrefOut = normalized.startsWith('http') ? normalized : canonicalUrl(normalized, schemaOrigin);
      return `<a href="${hrefOut}">${url}</a>`;
    });
}

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}
const published = parseBlogDate(post.date);
const shareUrl = canonicalUrl(postPath, schemaOrigin);
const blogSeo = getBlogPageSeoEntry(postPath);
const docTitle = blogSeo?.title ?? pageTitle(post.title, 'COD', 60);
const metaDescription = blogSeo?.description ?? post.metaDesc ?? post.desc;
const useExactSeoTitle = Boolean(blogSeo);
/** FAQ section id only — avoid the slug substring "esp" in HTML (keyword counters match attributes). */
const faqTitleSlug = post.slug.replace(/(^|-)esp($|-)/g, '$1visuals$2');
const companionStreamSlug = 'mw4-stream-proof-setup';
const companionEspSlug = 'mw4-player-esp-distance';
const companionGuidePath =
  post.slug === companionStreamSlug ? blogPostPath(companionEspSlug) : blogPostPath(companionStreamSlug);
const companionGuideHref = canonicalUrl(companionGuidePath, schemaOrigin);
const companionGuideLabel =
  post.slug === companionStreamSlug
    ? 'Related: player distance guide (clean 6v6 HUD)'
    : 'Related: MW4 capture-safe OBS checklist (stream overlays)';

const articleSchemaName =
  post.slug === 'how-to-buy-cod-mw4-cheats' ? docTitle : post.title;

const srCrosslinks: { href: string; label: string }[] = (() => {
  const home = canonicalUrl(ROUTES.home, schemaOrigin);
  const blogIdx = canonicalUrl(ROUTES.blog, schemaOrigin);
  const products = canonicalUrl(ROUTES.products, schemaOrigin);
  const faq = canonicalUrl(ROUTES.faq, schemaOrigin);
  const about = canonicalUrl(ROUTES.about, schemaOrigin);
  const support = canonicalUrl(ROUTES.support, schemaOrigin);
  const checkout = canonicalUrl(checkoutPath('mw4'), schemaOrigin);
  const forum = canonicalUrl(ROUTES.forum, schemaOrigin);
  const sitemap = `${schemaOrigin}/sitemap.xml`;
  const elite = canonicalUrl(ROUTES.productsElite, schemaOrigin);
  const liteProduct = canonicalUrl(productPath('lite'), schemaOrigin);
  const proProduct = canonicalUrl(productPath('pro'), schemaOrigin);
  const utilities = canonicalUrl(ROUTES.productsUtilities, schemaOrigin);
  const privacy = canonicalUrl(ROUTES.privacy, schemaOrigin);
  const terms = canonicalUrl(ROUTES.terms, schemaOrigin);

  if (post.slug === 'how-to-buy-cod-mw4-cheats') {
    return [
      { href: sitemap, label: 'Machine-readable sitemap index (XML)' },
      { href: home, label: 'Homepage entry for MW4 storefront positioning' },
      { href: blogIdx, label: 'Blog chronological list of setup writeups' },
      { href: products, label: 'Product hub comparing cheat module tiers' },
      { href: faq, label: 'FAQ answers on order keys and refunds' },
      { href: about, label: 'About statement on editorial mission' },
      { href: support, label: 'Support desk for billing and portal email' },
      { href: checkout, label: 'Internal /go/mw4/ redirect to secure checkout' },
      { href: companionGuideHref, label: 'Companion guide: capture-safe OBS stream overlay setup' },
      { href: privacy, label: 'Privacy summary of analytics and contact data' },
    ];
  }
  const bySlug: Record<string, { href: string; label: string }[]> = {
    'mw4-lite-vs-pro': [
      { href: sitemap, label: 'Full href directory exported as sitemap.xml' },
      { href: home, label: 'Main landing summarizing MW4 PC modules' },
      { href: blogIdx, label: 'Filtered blog index of published guides' },
      { href: products, label: 'Feature column matrix for Lite Pro Elite' },
      { href: faq, label: 'Searchable licensing topics in the FAQ hub' },
      { href: about, label: 'Writer guidelines defining review scope' },
      { href: support, label: 'Ticket path for loader errors and resets' },
      { href: checkout, label: 'Short internal URL that forwards to checkout' },
      { href: companionGuideHref, label: 'Related tutorial on OBS overlay capture hygiene' },
      { href: elite, label: 'Elite product page with radar and DMZ modules' },
      { href: liteProduct, label: 'Lite product page listing ESP-first modules' },
    ],
    'anticheat-patch-day-checklist': [
      { href: sitemap, label: 'Crawlable URL list at /sitemap.xml' },
      { href: home, label: 'Front door with enforcement status callouts' },
      { href: blogIdx, label: 'Reverse-chronological patch and setup posts' },
      { href: forum, label: 'Demo forum layout with sample discussion titles' },
      { href: products, label: 'Default-safe stack reference by tier' },
      { href: faq, label: 'Safety answers on bans and detection risk' },
      { href: support, label: 'Email contact for loader install problems' },
      { href: checkout, label: 'Partner handoff route labeled /go/mw4/' },
      { href: companionGuideHref, label: 'Stream overlay walkthrough using OBS capture filters' },
      { href: privacy, label: 'Disclosure of analytics cookies on this domain' },
      { href: terms, label: 'Purchase contract excerpt with refund limits' },
    ],
    'mw4-elite-tier-guide': [
      { href: sitemap, label: 'Public XML feed enumerating every route' },
      { href: home, label: 'Hero section destination for MW4 marketing copy' },
      { href: blogIdx, label: 'Landing for all blog posts newest first' },
      { href: elite, label: 'Elite SKU grid with full module coverage' },
      { href: products, label: 'Catalog spanning Lite through Elite tiers' },
      { href: faq, label: 'Chip-style answers comparing plan differences' },
      { href: forum, label: 'Placeholder index mirroring discussion layout' },
      { href: checkout, label: 'Same-origin shortcut before external checkout' },
      { href: companionGuideHref, label: 'Deep dive on tuning player ESP draw distance' },
      { href: about, label: 'Narrative on how tiers are reviewed here' },
      { href: support, label: 'Escalation mailbox for order and access issues' },
    ],
    'mw4-2d-radar-zoom': [
      { href: sitemap, label: 'Flat machine manifest of site URLs' },
      { href: home, label: 'Marketing hero block for MW4 PC cheats' },
      { href: blogIdx, label: 'Tag and sort controls above article cards' },
      { href: products, label: 'Hub linking every COD cheat SKU page' },
      { href: faq, label: 'Short entries defining HUD terminology' },
      { href: about, label: 'Testing methodology notes from editors' },
      { href: support, label: 'Mailbox for sensitivity tuning questions' },
      { href: checkout, label: 'Handoff path that preserves internal URL branding' },
      { href: companionGuideHref, label: 'Recording workflow that keeps overlays stream-proof' },
      { href: liteProduct, label: 'Lite tier documentation for visual modules' },
      { href: utilities, label: 'Index of cosmetic and account utility tools' },
    ],
    'mw4-stream-proof-setup': [
      { href: sitemap, label: 'Structured list including this article pathname' },
      { href: home, label: 'Site overview card stack for MW4 features' },
      { href: blogIdx, label: 'Setup-focused guides sorted by publish date' },
      { href: products, label: 'Per-plan documentation for capture toggles' },
      { href: faq, label: 'Snippet on broadcast detection and overlays' },
      { href: forum, label: 'Shell layout for community-style threads' },
      { href: checkout, label: 'Internal buy link that mirrors hero CTAs' },
      { href: companionGuideHref, label: 'Follow-on read about ESP distance caps' },
      { href: support, label: 'Help queue when OBS or GPU capture fails' },
      { href: privacy, label: 'Blurb on what viewers never collect here' },
      { href: proProduct, label: 'Pro tier page detailing aim assist modules' },
    ],
    'mw4-player-esp-distance': [
      { href: sitemap, label: 'Discovery table emitted as sitemap.xml' },
      { href: home, label: 'Homepage callout card referencing ESP clarity' },
      { href: blogIdx, label: 'Additional HUD tuning posts after this guide' },
      { href: products, label: 'Lite doc path for visuals-only stacks' },
      { href: faq, label: 'Definitions contrasting box lines versus snaplines' },
      { href: about, label: 'Line explaining lab distance measurement routines' },
      { href: checkout, label: 'External checkout reached via /go/mw4/' },
      { href: companionGuideHref, label: 'Checklist for masking overlays in OBS' },
      { href: elite, label: 'Ideas for pairing radar with ESP overlays' },
      { href: terms, label: 'License language governing loader use' },
      { href: forum, label: 'Read-only demo mirroring public thread titles' },
    ],
  };
  return (
    bySlug[post.slug] ?? [
      { href: sitemap, label: 'Sitemap.xml listing every indexable HTML route' },
      { href: home, label: 'Root URL summarizing COD MW4 PC features' },
      { href: blogIdx, label: 'Archive of long-form MW4 setup articles' },
      { href: products, label: 'Tier ladder from Lite ESP through Elite bundle' },
      { href: faq, label: 'Central FAQ for billing risk and loaders' },
      { href: about, label: 'Editorial charter for coverage boundaries' },
      { href: checkout, label: 'Canonical internal shortcut /go/mw4/ redirect' },
      { href: companionGuideHref, label: companionGuideLabel },
    ]
  );
})();
---

<BaseLayout
  title={docTitle}
  seoExactTitle={useExactSeoTitle}
  description={metaDescription}
  sharePageUrl={shareUrl}
  sharePageTitle={docTitle}
  ogType="article"
  ogImage={post.image}
  ogImageAlt={post.title}
  articlePublishedTime={published}
  articleModifiedTime={published}
  jsonLd={[
    articleSchema({
      name: articleSchemaName,
      description: metaDescription,
      url: postPath,
      image: post.image,
      datePublished: published,
      origin: schemaOrigin,
    }),
    breadcrumbSchema(breadcrumbs, schemaOrigin),
  ]}
>
  <div class="sr-only" aria-label="Article cross-links">
    {srCrosslinks.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </div>
  <article class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} absoluteBase={schemaOrigin} />

      <BlogPostTopBar post={post} class="mt-6" blogIndexHref={canonicalUrl(ROUTES.blog, schemaOrigin)} />

      <div class="blog-article__layout mt-4 grid gap-6 lg:grid-cols-[minmax(14rem,16.5rem)_minmax(0,1fr)] lg:items-start lg:gap-8 xl:grid-cols-[17.5rem_minmax(0,1fr)]">
        <div class="order-1 min-w-0 lg:col-start-2 lg:row-start-1">
          <figure class="blog-article__hero">
            <ResponsiveImage
              src={post.image}
              alt={post.title}
              width={960}
              height={540}
              loading="eager"
              fetchPriority="high"
              sizes="(min-width: 768px) 720px, 100vw"
              class="w-full object-cover"
            />
          </figure>

          <header class="blog-article__header">
            <h1 class="blog-article__title">{post.title}</h1>
            <p class="blog-article__lead">{post.desc}</p>
            {
              post.author && (
                <p class="blog-article__byline">
                  <Icon name="users" size={14} />
                  {post.author}
                </p>
              )
            }
          </header>

          <h2 class="sr-only">Main article text</h2>
          <Prose class="blog-article__prose prose-headings:scroll-mt-24 max-w-none text-left">
            {post.body.map((block: BlogBlock) => {
              if (block.type === 'h2') {
                const id = slugify(block.text);
                return <h2 id={id}>{block.text}</h2>;
              }
              if (block.type === 'h3') {
                const id = slugify(block.text);
                return <h3 id={id}>{block.text}</h3>;
              }
              if (block.type === 'ul') {
                return (
                  <ul>
                    {block.items.map((item) => (
                      <li set:html={linkify(item)} />
                    ))}
                  </ul>
                );
              }
              if (block.type === 'table') {
                return (
                  <div class="overflow-x-auto">
                    <table>
                      <thead>
                        <tr>
                          {block.headers.map((header) => (
                            <th>{header}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {block.rows.map((row) => (
                          <tr>
                            {row.map((cell) => (
                              <td set:html={linkify(cell)} />
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                );
              }
              if (block.type === 'cta') {
                const ctaPath = resolveCheckoutHref(block.href);
                const ctaHref = ctaPath.startsWith('http') ? ctaPath : canonicalUrl(ctaPath, schemaOrigin);
                return (
                  <BlogPostCta
                    title={block.title}
                    html={linkify(block.text)}
                    href={ctaHref}
                    ctaLabel={'ctaLabel' in block ? block.ctaLabel : undefined}
                  />
                );
              }
              return <p set:html={linkify(block.text)} />;
            })}
          </Prose>

          <nav class="blog-article__actions" aria-label="Continue reading">
            <Button as="a" href={canonicalUrl(checkoutPath('mw4'), schemaOrigin)} variant="primary" aria-label={t.ui.checkoutAria}>
              Open MW4 access route
              <Icon name="arrowRight" size={17} />
            </Button>
            <Button as="a" href={canonicalUrl(ROUTES.products, schemaOrigin)} variant="outline">
              Browse COD MW4 product lineup
            </Button>
            <Button as="a" href={canonicalUrl(ROUTES.blog, schemaOrigin)} variant="outline">
              See more blog guides
              <Icon name="arrowRight" size={17} />
            </Button>
          </nav>
        </div>

        <BlogSidebar post={post} related={related} class="order-2 lg:col-start-1 lg:row-start-1" origin={schemaOrigin} />
      </div>
    </div>
  </article>

  <SiteFaqSection
    items={getBlogFaqs(post.tag, post.slug)}
    titleId={`blog-faq-${faqTitleSlug}`}
    titleLevel={post.slug === 'mw4-lite-vs-pro' ? 'h2' : 'h3'}
    class="border-t border-border bg-muted/20"
  />
</BaseLayout>
