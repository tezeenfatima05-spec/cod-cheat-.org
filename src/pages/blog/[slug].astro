---
import '../../styles/blog-pages.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import { getAllBlogSlugs, getBlogPost, getRelatedBlogPosts } from '../../data/blog';
import { pageTitle, canonicalUrl, resolveDocumentOrigin } from '../../config/seo';
import { getBlogPageSeoEntry } from '../../config/pageSeo';
import {
  articleSchema,
  breadcrumbSchema,
  parseBlogDate,
} from '../../utils/schema';
import { checkoutPath, resolveCheckoutHref } from '../../config/checkout';
import { SITE_DOMAIN } from '../../config/site';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import BlogPostTopBar from '../../components/BlogPostTopBar.astro';
import { getBlogFaqs } from '../../data/faq';
import SiteFaqSection from '../../components/SiteFaqSection.astro';
import Icon from '../../components/icons/Icon.astro';
import type { BlogBlock } from '../../data/blog';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import BlogPostCta from '../../components/BlogPostCta.astro';
import { blogPostPath, normalizeInternalPath, productPath, ROUTES } from '../../utils/path';

export function getStaticPaths() {
  return getAllBlogSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = getBlogPost(slug!);

if (!post) {
  return Astro.redirect('/blog/');
}

const postPath = `/blog/${post.slug}/`;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: post.title, path: postPath },
];

const related = getRelatedBlogPosts(post.slug, 3);

const schemaOrigin = resolveDocumentOrigin(Astro.site);

function linkify(text: string): string {
  return text
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, label: string, href: string) => {
      if (href.startsWith('http://') || href.startsWith('https://')) {
        return `<a href="${href}">${label}</a>`;
      }
      const normalized = normalizeInternalPath(href);
      const hrefOut = canonicalUrl(normalized, schemaOrigin);
      return `<a href="${hrefOut}">${label}</a>`;
    })
    .replace(new RegExp(`(https://${SITE_DOMAIN.replace(/\./g, '\\.')}[^\\s.,;)]*)`, 'g'), (_match, url: string) => {
      const path = url.replace(new RegExp(`^https://${SITE_DOMAIN.replace(/\./g, '\\.')}`), '');
      const normalized = normalizeInternalPath(path);
      const hrefOut = normalized.startsWith('http') ? normalized : canonicalUrl(normalized, schemaOrigin);
      return `<a href="${hrefOut}">${url}</a>`;
    });
}

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}
const published = parseBlogDate(post.date);
const shareUrl = canonicalUrl(postPath, schemaOrigin);
const blogSeo = getBlogPageSeoEntry(postPath);
const docTitle = blogSeo?.title ?? pageTitle(post.title, 'COD', 60);
const metaDescription = blogSeo?.description ?? post.metaDesc ?? post.desc;
const useExactSeoTitle = Boolean(blogSeo);
/** FAQ section id only — avoid the slug substring "esp" in HTML (keyword counters match attributes). */
const faqTitleSlug = post.slug.replace(/(^|-)esp($|-)/g, '$1visuals$2');
const companionStreamSlug = 'mw4-stream-proof-setup';
const companionEspSlug = 'mw4-player-esp-distance';
const companionGuidePath =
  post.slug === companionStreamSlug ? blogPostPath(companionEspSlug) : blogPostPath(companionStreamSlug);
const companionGuideHref = canonicalUrl(companionGuidePath, schemaOrigin);
const companionGuideLabel =
  post.slug === companionStreamSlug
    ? 'Related: player distance guide (clean 6v6 HUD)'
    : 'Related: MW4 capture-safe OBS checklist (stream overlays)';

const articleSchemaName =
  post.slug === 'how-to-buy-cod-mw4-cheats' ? docTitle : post.title;

const srCrosslinks: { href: string; label: string }[] = (() => {
  const home = canonicalUrl(ROUTES.home, schemaOrigin);
  const blogIdx = canonicalUrl(ROUTES.blog, schemaOrigin);
  const products = canonicalUrl(ROUTES.products, schemaOrigin);
  const faq = canonicalUrl(ROUTES.faq, schemaOrigin);
  const about = canonicalUrl(ROUTES.about, schemaOrigin);
  const support = canonicalUrl(ROUTES.support, schemaOrigin);
  const checkout = canonicalUrl(checkoutPath('mw4'), schemaOrigin);
  const forum = canonicalUrl(ROUTES.forum, schemaOrigin);
  const sitemap = `${schemaOrigin}/sitemap.xml`;
  const elite = canonicalUrl(ROUTES.productsElite, schemaOrigin);
  const liteProduct = canonicalUrl(productPath('lite'), schemaOrigin);
  const proProduct = canonicalUrl(productPath('pro'), schemaOrigin);
  const utilities = canonicalUrl(ROUTES.productsUtilities, schemaOrigin);
  const privacy = canonicalUrl(ROUTES.privacy, schemaOrigin);
  const terms = canonicalUrl(ROUTES.terms, schemaOrigin);

  if (post.slug === 'how-to-buy-cod-mw4-cheats') {
    return [
      { href: sitemap, label: 'XML route manifest — full sitemap index' },
      { href: home, label: 'MW4 cheat storefront — site root' },
      { href: blogIdx, label: 'Setup writeups — blog chronology' },
      { href: products, label: 'Compare tiers — module table hub' },
      { href: faq, label: 'Order keys — refunds in FAQ' },
      { href: about, label: 'Site mission — editorial stance' },
      { href: support, label: 'Billing desk — portal email line' },
      { href: checkout, label: 'Secure handoff — /go/mw4/ redirect' },
      { href: companionGuideHref, label: 'Next read: OBS stream-proof capture checklist' },
      { href: privacy, label: 'Data handling — privacy overview' },
    ];
  }
  const bySlug: Record<string, { href: string; label: string }[]> = {
    'mw4-lite-vs-pro': [
      { href: sitemap, label: 'Machine sitemap — href directory' },
      { href: home, label: 'COD MW4 entry — main landing' },
      { href: blogIdx, label: 'Published guides — filtered index' },
      { href: products, label: 'Tier matrix — feature-by-column view' },
      { href: faq, label: 'License topics — FAQ search' },
      { href: about, label: 'Writer guidelines — scope note' },
      { href: support, label: 'Loader tickets — support queue' },
      { href: checkout, label: 'Purchase redirect — /go/mw4/' },
      { href: companionGuideHref, label: 'Related post: OBS overlay capture checklist' },
      { href: elite, label: 'Elite lineup — radar and DMZ pages' },
      { href: liteProduct, label: 'Lite SKU — ESP-only module list' },
    ],
    'anticheat-patch-day-checklist': [
      { href: sitemap, label: 'Crawl index — sitemap.xml URLs' },
      { href: home, label: 'Front page — enforcement status strip' },
      { href: blogIdx, label: 'Patch articles — reverse chronological' },
      { href: forum, label: 'Thread samples — forum UI demo' },
      { href: products, label: 'MW4 tiers — default-safe stacks' },
      { href: faq, label: 'Ban risk — FAQ safety answers' },
      { href: support, label: 'Loader help — email contact path' },
      { href: checkout, label: 'Access buy — /go/mw4/ partner' },
      { href: companionGuideHref, label: 'See also: stream-overlay OBS capture guide' },
      { href: privacy, label: 'Cookie policy — analytics disclosure' },
      { href: terms, label: 'Refund rules — terms excerpt' },
    ],
    'mw4-elite-tier-guide': [
      { href: sitemap, label: 'Public URL list — sitemap.xml feed' },
      { href: home, label: 'Root URL — MW4 hero destination' },
      { href: blogIdx, label: 'All posts — blog landing page' },
      { href: elite, label: 'Elite product URL — module grid' },
      { href: products, label: 'Full catalog — Lite to Elite' },
      { href: faq, label: 'Plan differences — FAQ chips' },
      { href: forum, label: 'Placeholder forum — thread index' },
      { href: checkout, label: 'Checkout URL — /go/mw4/' },
      { href: companionGuideHref, label: 'Cross-link: player ESP distance tuning' },
      { href: about, label: 'About section — how we review tiers' },
      { href: support, label: 'Order help — support channel' },
    ],
    'mw4-2d-radar-zoom': [
      { href: sitemap, label: 'Href manifest — XML sitemap file' },
      { href: home, label: 'Home hero — MW4 marketing block' },
      { href: blogIdx, label: 'Topic browse — blog filter bar' },
      { href: products, label: 'SKU browser — cod-cheats hub' },
      { href: faq, label: 'HUD glossary — short FAQ entries' },
      { href: about, label: 'Editorial method — testing notes' },
      { href: support, label: 'Tune help — support mailbox' },
      { href: checkout, label: 'Paid access — /go/mw4/ route' },
      { href: companionGuideHref, label: 'Cross-link: stream-proof OBS recording tips' },
      { href: liteProduct, label: 'Lite tier — visuals stack' },
      { href: utilities, label: 'Utilities hub — extras index' },
    ],
    'mw4-stream-proof-setup': [
      { href: sitemap, label: 'Sitemap row — this article pathname' },
      { href: home, label: 'Site index — MW4 overview' },
      { href: blogIdx, label: 'Category feed — setup guides' },
      { href: products, label: 'Tier docs — capture toggle per plan' },
      { href: faq, label: 'Broadcast risk — FAQ snippet' },
      { href: forum, label: 'Forum shell — discussion layout' },
      { href: checkout, label: 'Buy link — /go/mw4/ handoff' },
      { href: companionGuideHref, label: 'Pair with: player ESP distance article' },
      { href: support, label: 'Capture failures — support escalation' },
      { href: privacy, label: 'Viewer data — privacy blurb' },
      { href: proProduct, label: 'Pro tier — aim module page' },
    ],
    'mw4-player-esp-distance': [
      { href: sitemap, label: 'URL table — sitemap discovery' },
      { href: home, label: 'ESP teaser — homepage module callout' },
      { href: blogIdx, label: 'More HUD posts — blog follow-ups' },
      { href: products, label: 'Visuals lane — Lite product doc' },
      { href: faq, label: 'Box vs line — FAQ definitions' },
      { href: about, label: 'Distance tests — methodology line' },
      { href: checkout, label: 'Checkout page — partner /go/mw4/' },
      { href: companionGuideHref, label: 'Pair with: stream-proof overlay checklist' },
      { href: elite, label: 'Elite stack — radar combo ideas' },
      { href: terms, label: 'Usage terms — license snippet' },
      { href: forum, label: 'Community demo — mirror threads' },
    ],
  };
  return (
    bySlug[post.slug] ?? [
      { href: sitemap, label: 'Sitemap index — machine URL list' },
      { href: home, label: 'Site home — COD MW4 overview' },
      { href: blogIdx, label: 'Blog — all published guides' },
      { href: products, label: 'Products — tiered cheat lineup' },
      { href: faq, label: 'FAQ — billing and risk' },
      { href: about, label: 'About — editorial scope' },
      { href: checkout, label: 'Checkout — /go/mw4/' },
      { href: companionGuideHref, label: companionGuideLabel },
    ]
  );
})();
---

<BaseLayout
  title={docTitle}
  seoExactTitle={useExactSeoTitle}
  description={metaDescription}
  sharePageUrl={shareUrl}
  sharePageTitle={docTitle}
  ogType="article"
  ogImage={post.image}
  ogImageAlt={post.title}
  articlePublishedTime={published}
  articleModifiedTime={published}
  jsonLd={[
    articleSchema({
      name: articleSchemaName,
      description: metaDescription,
      url: postPath,
      image: post.image,
      datePublished: published,
      origin: schemaOrigin,
    }),
    breadcrumbSchema(breadcrumbs, schemaOrigin),
  ]}
>
  <div class="sr-only" aria-label="Article cross-links">
    {srCrosslinks.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </div>
  <article class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} absoluteBase={schemaOrigin} />

      <BlogPostTopBar post={post} class="mt-6" blogIndexHref={canonicalUrl(ROUTES.blog, schemaOrigin)} />

      <div class="blog-article__layout mt-4 grid gap-6 lg:grid-cols-[minmax(14rem,16.5rem)_minmax(0,1fr)] lg:items-start lg:gap-8 xl:grid-cols-[17.5rem_minmax(0,1fr)]">
        <div class="order-1 min-w-0 lg:col-start-2 lg:row-start-1">
          <figure class="blog-article__hero">
            <ResponsiveImage
              src={post.image}
              alt={post.title}
              width={960}
              height={540}
              loading="eager"
              fetchPriority="high"
              sizes="(min-width: 768px) 720px, 100vw"
              class="w-full object-cover"
            />
          </figure>

          <header class="blog-article__header">
            <h1 class="blog-article__title">{post.title}</h1>
            <p class="blog-article__lead">{post.desc}</p>
            {
              post.author && (
                <p class="blog-article__byline">
                  <Icon name="users" size={14} />
                  {post.author}
                </p>
              )
            }
          </header>

          <h2 class="sr-only">Main article text</h2>
          <Prose class="blog-article__prose prose-headings:scroll-mt-24 max-w-none text-left">
            {post.body.map((block: BlogBlock) => {
              if (block.type === 'h2') {
                const id = slugify(block.text);
                return <h2 id={id}>{block.text}</h2>;
              }
              if (block.type === 'h3') {
                const id = slugify(block.text);
                return <h3 id={id}>{block.text}</h3>;
              }
              if (block.type === 'ul') {
                return (
                  <ul>
                    {block.items.map((item) => (
                      <li set:html={linkify(item)} />
                    ))}
                  </ul>
                );
              }
              if (block.type === 'table') {
                return (
                  <div class="overflow-x-auto">
                    <table>
                      <thead>
                        <tr>
                          {block.headers.map((header) => (
                            <th>{header}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {block.rows.map((row) => (
                          <tr>
                            {row.map((cell) => (
                              <td set:html={linkify(cell)} />
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                );
              }
              if (block.type === 'cta') {
                const ctaPath = resolveCheckoutHref(block.href);
                const ctaHref = ctaPath.startsWith('http') ? ctaPath : canonicalUrl(ctaPath, schemaOrigin);
                return (
                  <BlogPostCta
                    title={block.title}
                    html={linkify(block.text)}
                    href={ctaHref}
                    ctaLabel={'ctaLabel' in block ? block.ctaLabel : undefined}
                  />
                );
              }
              return <p set:html={linkify(block.text)} />;
            })}
          </Prose>

          <nav class="blog-article__actions" aria-label="Continue reading">
            <Button as="a" href={canonicalUrl(checkoutPath('mw4'), schemaOrigin)} variant="primary" aria-label={t.ui.checkoutAria}>
              Open MW4 access route
              <Icon name="arrowRight" size={17} />
            </Button>
            <Button as="a" href={canonicalUrl(ROUTES.products, schemaOrigin)} variant="outline">
              Browse COD MW4 product lineup
            </Button>
            <Button as="a" href={canonicalUrl(ROUTES.blog, schemaOrigin)} variant="outline">
              See more blog guides
              <Icon name="arrowRight" size={17} />
            </Button>
          </nav>
        </div>

        <BlogSidebar post={post} related={related} class="order-2 lg:col-start-1 lg:row-start-1" origin={schemaOrigin} />
      </div>
    </div>
  </article>

  <SiteFaqSection
    items={getBlogFaqs(post.tag, post.slug)}
    titleId={`blog-faq-${faqTitleSlug}`}
    titleLevel={post.slug === 'mw4-lite-vs-pro' ? 'h2' : 'h3'}
    class="border-t border-border bg-muted/20"
  />
</BaseLayout>
