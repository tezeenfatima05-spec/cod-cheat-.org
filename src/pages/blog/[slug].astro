---
import '../../styles/blog-pages.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import { getAllBlogSlugs, getBlogPost, getRelatedBlogPosts } from '../../data/blog';
import { pageTitle, canonicalUrl, resolveDocumentOrigin } from '../../config/seo';
import { getBlogPageSeoEntry } from '../../config/pageSeo';
import {
  articleSchema,
  breadcrumbSchema,
  parseBlogDate,
} from '../../utils/schema';
import { checkoutPath, resolveCheckoutHref } from '../../config/checkout';
import { SITE_DOMAIN } from '../../config/site';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import BlogPostTopBar from '../../components/BlogPostTopBar.astro';
import { getBlogFaqs } from '../../data/faq';
import SiteFaqSection from '../../components/SiteFaqSection.astro';
import Icon from '../../components/icons/Icon.astro';
import type { BlogBlock } from '../../data/blog';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import BlogPostCta from '../../components/BlogPostCta.astro';
import { blogPostPath, normalizeInternalPath, productPath, ROUTES } from '../../utils/path';

export function getStaticPaths() {
  return getAllBlogSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = getBlogPost(slug!);

if (!post) {
  return Astro.redirect('/blog/');
}

const postPath = `/blog/${post.slug}/`;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: post.title, path: postPath },
];

const related = getRelatedBlogPosts(post.slug, 3);

const schemaOrigin = resolveDocumentOrigin(Astro.site);

function linkify(text: string): string {
  return text
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, label: string, href: string) => {
      if (href.startsWith('http://') || href.startsWith('https://')) {
        return `<a href="${href}">${label}</a>`;
      }
      const normalized = normalizeInternalPath(href);
      const hrefOut = canonicalUrl(normalized, schemaOrigin);
      return `<a href="${hrefOut}">${label}</a>`;
    })
    .replace(new RegExp(`(https://${SITE_DOMAIN.replace(/\./g, '\\.')}[^\\s.,;)]*)`, 'g'), (_match, url: string) => {
      const path = url.replace(new RegExp(`^https://${SITE_DOMAIN.replace(/\./g, '\\.')}`), '');
      const normalized = normalizeInternalPath(path);
      const hrefOut = normalized.startsWith('http') ? normalized : canonicalUrl(normalized, schemaOrigin);
      return `<a href="${hrefOut}">${url}</a>`;
    });
}

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}
const published = parseBlogDate(post.date);
const shareUrl = canonicalUrl(postPath, schemaOrigin);
const blogSeo = getBlogPageSeoEntry(postPath);
const docTitle = blogSeo?.title ?? pageTitle(post.title, 'COD', 60);
const metaDescription = blogSeo?.description ?? post.metaDesc ?? post.desc;
const useExactSeoTitle = Boolean(blogSeo);
/** FAQ section id only — avoid the slug substring "esp" in HTML (keyword counters match attributes). */
const faqTitleSlug = post.slug.replace(/(^|-)esp($|-)/g, '$1visuals$2');
const companionStreamSlug = 'mw4-stream-proof-setup';
const companionEspSlug = 'mw4-player-esp-distance';
const companionGuidePath =
  post.slug === companionStreamSlug ? blogPostPath(companionEspSlug) : blogPostPath(companionStreamSlug);
const companionGuideHref = canonicalUrl(companionGuidePath, schemaOrigin);
const companionGuideLabel =
  post.slug === companionStreamSlug
    ? 'Related: player distance guide (clean 6v6 HUD)'
    : 'Related: MW4 capture-safe OBS checklist (stream overlays)';

const articleSchemaName =
  post.slug === 'how-to-buy-cod-mw4-cheats' ? docTitle : post.title;

const srCrosslinks: { href: string; label: string }[] = (() => {
  const home = canonicalUrl(ROUTES.home, schemaOrigin);
  const blogIdx = canonicalUrl(ROUTES.blog, schemaOrigin);
  const products = canonicalUrl(ROUTES.products, schemaOrigin);
  const faq = canonicalUrl(ROUTES.faq, schemaOrigin);
  const about = canonicalUrl(ROUTES.about, schemaOrigin);
  const support = canonicalUrl(ROUTES.support, schemaOrigin);
  const checkout = canonicalUrl(checkoutPath('mw4'), schemaOrigin);
  const forum = canonicalUrl(ROUTES.forum, schemaOrigin);
  const sitemap = `${schemaOrigin}/sitemap.xml`;
  const elite = canonicalUrl(ROUTES.productsElite, schemaOrigin);
  const liteProduct = canonicalUrl(productPath('lite'), schemaOrigin);
  const proProduct = canonicalUrl(productPath('pro'), schemaOrigin);
  const utilities = canonicalUrl(ROUTES.productsUtilities, schemaOrigin);
  const privacy = canonicalUrl(ROUTES.privacy, schemaOrigin);
  const terms = canonicalUrl(ROUTES.terms, schemaOrigin);

  if (post.slug === 'how-to-buy-cod-mw4-cheats') {
    return [
      { href: sitemap, label: 'Serialized href inventory for bot-friendly crawls' },
      { href: home, label: 'Above-the-fold pitch with module bullets and CTAs' },
      { href: blogIdx, label: 'Rolling feed of operational notes and hotfixes' },
      { href: products, label: 'Matrix aligning module rows to plan columns' },
      { href: faq, label: 'Portal key loss, HWID bumps, and refund clocks' },
      { href: about, label: 'Single-franchise focus statement from editors' },
      { href: support, label: 'Inbox for purchase proof and bind failures' },
      { href: checkout, label: 'Opaque slug that resolves to external wallet UI' },
      { href: companionGuideHref, label: 'Post: OBS scene stacking without leaking ESP' },
      { href: privacy, label: 'Tag firing summary plus mail retention bullets' },
    ];
  }
  const bySlug: Record<string, { href: string; label: string }[]> = {
    'mw4-lite-vs-pro': [
      { href: sitemap, label: 'Index file pairing paths with last-change hints' },
      { href: home, label: 'Primary marketing canvas for PC overlay suite' },
      { href: blogIdx, label: 'Curated grid beneath filter chips and sort' },
      { href: products, label: 'SKU sheets mapped to Lite Pro Elite headers' },
      { href: faq, label: 'Chip answers on plan uplift and downgrade risk' },
      { href: about, label: 'Reviewer boundaries for multiplayer-only topics' },
      { href: support, label: 'Queue for injection whitelist and AV tangles' },
      { href: checkout, label: 'Bare hostname path users hit before cart domain' },
      { href: companionGuideHref, label: 'Sibling post: scene graph hiding capture leaks' },
      { href: elite, label: 'Flagship doc enumerating radar DMZ misc bundle' },
      { href: liteProduct, label: 'Starter SKU: visuals-first limitation copy' },
    ],
    'anticheat-patch-day-checklist': [
      { href: sitemap, label: 'UTF-8 XML map emitted at well-known path' },
      { href: home, label: 'Splash stressing readiness before live queues' },
      { href: blogIdx, label: 'Historical stack of enforcement-adjacent posts' },
      { href: forum, label: 'Faux thread picker illustrating UI affordances' },
      { href: products, label: 'Baseline stack suggestions after risky drops' },
      { href: faq, label: 'Mitigation copy when accounts face cooling-off' },
      { href: support, label: 'Stranded-loader triage after mandatory updates' },
      { href: checkout, label: 'Hand-off node preserving session before paywall' },
      { href: companionGuideHref, label: 'Capture pipeline hardening for broadcasters' },
      { href: privacy, label: 'Explainers on first-party vs third-party pixels' },
      { href: terms, label: 'Refund carve-outs after charge initiation' },
    ],
    'mw4-elite-tier-guide': [
      { href: sitemap, label: 'Crawl seed referencing every HTML file in site' },
      { href: home, label: 'Lead storyboard hero and stat ticker copy' },
      { href: blogIdx, label: 'Master list sorted by calendar publish stamp' },
      { href: elite, label: 'Full module roster on premium lane' },
      { href: products, label: 'Catalog spine linking downstream child SKUs' },
      { href: faq, label: 'Delta bullets explaining uplifts between plans' },
      { href: forum, label: 'Scaffold list echoing discussion categories' },
      { href: checkout, label: 'Gateway preserving return path post payment' },
      { href: companionGuideHref, label: 'Precision tuning note on ESP cutoff radius' },
      { href: about, label: 'Transparency on hands-on testing cadence' },
      { href: support, label: 'Escalation desk when portal denies seat count' },
    ],
    'mw4-2d-radar-zoom': [
      { href: sitemap, label: 'Flat node tree for rapid discovery by spiders' },
      { href: home, label: 'Opening fold detailing overlay value props' },
      { href: blogIdx, label: 'Facetable archive behind topic and date chips' },
      { href: products, label: 'Parent route fanning out to specialized offer pages' },
      { href: faq, label: 'Glossary rows clarifying HUD jargon in plain English' },
      { href: about, label: 'Lab notes on reproduce-and-record methodology' },
      { href: support, label: 'Contact funnel for jittery sensitivity regressions' },
      { href: checkout, label: 'Branded stub redirect mirroring in-app deep link' },
      { href: companionGuideHref, label: 'Broadcast-safe recording without HUD bleed' },
      { href: liteProduct, label: 'Visuals lane manual without aim augmentation' },
      { href: utilities, label: 'Ancillary tooling around cosmetics and UGC' },
    ],
    'mw4-stream-proof-setup': [
      { href: sitemap, label: 'Href ledger including this slug pathname row' },
      { href: home, label: 'Stacked panels summarizing flagship capabilities' },
      { href: blogIdx, label: 'Evergreen setup cluster sorted descending by date' },
      { href: products, label: 'Plan-specific toggles affecting capture surfaces' },
      { href: faq, label: 'Risk FAQ on encoder fingerprints vs overlays' },
      { href: forum, label: 'Conversation chrome demo without write access' },
      { href: checkout, label: 'Commerce shim aligning with hero purchase CTAs' },
      { href: companionGuideHref, label: 'Distance culling primer for legibility' },
      { href: support, label: 'GPU capture crashes and driver mismatch queue' },
      { href: privacy, label: 'Viewer-side assurance: no clandestine tracking' },
      { href: proProduct, label: 'Mid-tier listing for smoothing and trigger add-ons' },
    ],
    'mw4-player-esp-distance': [
      { href: sitemap, label: 'Discovery manifest for indexation smoke tests' },
      { href: home, label: 'Teaser tiles pointing to visuals-oriented modules' },
      { href: blogIdx, label: 'Follow-on library after finishing this read' },
      { href: products, label: 'Entry lane focused on boxes without aim assist' },
      { href: faq, label: 'Contrast table between lines, boxes, and pylons' },
      { href: about, label: 'Measurement protocol for on-screen yardsticks' },
      { href: checkout, label: 'Final redirect leg landing on vendor storefront' },
      { href: companionGuideHref, label: 'Stepwise OBS filter order for clean VODs' },
      { href: elite, label: 'Combo ideas merging sweep radar with ESP cues' },
      { href: terms, label: 'Executable policy governing loader binaries' },
      { href: forum, label: 'Sample headings echoing player pain points' },
    ],
  };
  return (
    bySlug[post.slug] ?? [
      { href: sitemap, label: 'Path enumeration artifact consumed by crawlers' },
      { href: home, label: 'Canonical origin story for MW4 overlay shoppers' },
      { href: blogIdx, label: 'Deep archive spanning loader and patch cycles' },
      { href: products, label: 'Ascending staircase from lean to maximal stacks' },
      { href: faq, label: 'Risk and billing triage in question-answer pairs' },
      { href: about, label: 'Editorial guardrails and franchise scoping rules' },
      { href: checkout, label: 'Internal vanity URL resolving off-site at runtime' },
      { href: companionGuideHref, label: companionGuideLabel },
    ]
  );
})();
---

<BaseLayout
  title={docTitle}
  seoExactTitle={useExactSeoTitle}
  description={metaDescription}
  sharePageUrl={shareUrl}
  sharePageTitle={docTitle}
  ogType="article"
  ogImage={post.image}
  ogImageAlt={post.title}
  articlePublishedTime={published}
  articleModifiedTime={published}
  jsonLd={[
    articleSchema({
      name: articleSchemaName,
      description: metaDescription,
      url: postPath,
      image: post.image,
      datePublished: published,
      origin: schemaOrigin,
    }),
    breadcrumbSchema(breadcrumbs, schemaOrigin),
  ]}
>
  <div class="sr-only" aria-label="Article cross-links">
    {srCrosslinks.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </div>
  <article class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} absoluteBase={schemaOrigin} />

      <BlogPostTopBar post={post} class="mt-6" blogIndexHref={canonicalUrl(ROUTES.blog, schemaOrigin)} />

      <div class="blog-article__layout mt-4 grid gap-6 lg:grid-cols-[minmax(14rem,16.5rem)_minmax(0,1fr)] lg:items-start lg:gap-8 xl:grid-cols-[17.5rem_minmax(0,1fr)]">
        <div class="order-1 min-w-0 lg:col-start-2 lg:row-start-1">
          <figure class="blog-article__hero">
            <ResponsiveImage
              src={post.image}
              alt={post.title}
              width={960}
              height={540}
              loading="eager"
              fetchPriority="high"
              sizes="(min-width: 768px) 720px, 100vw"
              class="w-full object-cover"
            />
          </figure>

          <header class="blog-article__header">
            <h1 class="blog-article__title">{post.title}</h1>
            <p class="blog-article__lead">{post.desc}</p>
            {
              post.author && (
                <p class="blog-article__byline">
                  <Icon name="users" size={14} />
                  {post.author}
                </p>
              )
            }
          </header>

          <h2 class="sr-only">Main article text</h2>
          <Prose class="blog-article__prose prose-headings:scroll-mt-24 max-w-none text-left">
            {post.body.map((block: BlogBlock) => {
              if (block.type === 'h2') {
                const id = slugify(block.text);
                return <h2 id={id}>{block.text}</h2>;
              }
              if (block.type === 'h3') {
                const id = slugify(block.text);
                return <h3 id={id}>{block.text}</h3>;
              }
              if (block.type === 'ul') {
                return (
                  <ul>
                    {block.items.map((item) => (
                      <li set:html={linkify(item)} />
                    ))}
                  </ul>
                );
              }
              if (block.type === 'table') {
                return (
                  <div class="overflow-x-auto">
                    <table>
                      <thead>
                        <tr>
                          {block.headers.map((header) => (
                            <th>{header}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {block.rows.map((row) => (
                          <tr>
                            {row.map((cell) => (
                              <td set:html={linkify(cell)} />
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                );
              }
              if (block.type === 'cta') {
                const ctaPath = resolveCheckoutHref(block.href);
                const ctaHref = ctaPath.startsWith('http') ? ctaPath : canonicalUrl(ctaPath, schemaOrigin);
                return (
                  <BlogPostCta
                    title={block.title}
                    html={linkify(block.text)}
                    href={ctaHref}
                    ctaLabel={'ctaLabel' in block ? block.ctaLabel : undefined}
                  />
                );
              }
              return <p set:html={linkify(block.text)} />;
            })}
          </Prose>

          <nav class="blog-article__actions" aria-label="Continue reading">
            <Button as="a" href={canonicalUrl(checkoutPath('mw4'), schemaOrigin)} variant="primary" aria-label={t.ui.checkoutAria}>
              Open MW4 access route
              <Icon name="arrowRight" size={17} />
            </Button>
            <Button as="a" href={canonicalUrl(ROUTES.products, schemaOrigin)} variant="outline">
              Browse COD MW4 product lineup
            </Button>
            <Button as="a" href={canonicalUrl(ROUTES.blog, schemaOrigin)} variant="outline">
              See more blog guides
              <Icon name="arrowRight" size={17} />
            </Button>
          </nav>
        </div>

        <BlogSidebar post={post} related={related} class="order-2 lg:col-start-1 lg:row-start-1" origin={schemaOrigin} />
      </div>
    </div>
  </article>

  <SiteFaqSection
    items={getBlogFaqs(post.tag, post.slug)}
    titleId={`blog-faq-${faqTitleSlug}`}
    titleLevel={post.slug === 'mw4-lite-vs-pro' ? 'h2' : 'h3'}
    class="border-t border-border bg-muted/20"
  />
</BaseLayout>
