---
import '../../styles/blog-pages.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import { getAllBlogSlugs, getBlogPost, getRelatedBlogPosts } from '../../data/blog';
import { pageTitle, canonicalUrl, resolveDocumentOrigin } from '../../config/seo';
import { getBlogPageSeoEntry } from '../../config/pageSeo';
import {
  articleSchema,
  breadcrumbSchema,
  parseBlogDate,
} from '../../utils/schema';
import { checkoutPath, resolveCheckoutHref } from '../../config/checkout';
import { SITE_DOMAIN } from '../../config/site';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import BlogPostTopBar from '../../components/BlogPostTopBar.astro';
import { getBlogFaqs } from '../../data/faq';
import SiteFaqSection from '../../components/SiteFaqSection.astro';
import Icon from '../../components/icons/Icon.astro';
import type { BlogBlock } from '../../data/blog';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import BlogPostCta from '../../components/BlogPostCta.astro';
import { blogPostPath, normalizeInternalPath, ROUTES } from '../../utils/path';

export function getStaticPaths() {
  return getAllBlogSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = getBlogPost(slug!);

if (!post) {
  return Astro.redirect('/blog/');
}

const postPath = `/blog/${post.slug}/`;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: post.title, path: postPath },
];

const related = getRelatedBlogPosts(post.slug, 3);

const schemaOrigin = resolveDocumentOrigin(Astro.site);

function linkify(text: string): string {
  return text
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, label: string, href: string) => {
      if (href.startsWith('http://') || href.startsWith('https://')) {
        return `<a href="${href}">${label}</a>`;
      }
      const normalized = normalizeInternalPath(href);
      const hrefOut = canonicalUrl(normalized, schemaOrigin);
      return `<a href="${hrefOut}">${label}</a>`;
    })
    .replace(new RegExp(`(https://${SITE_DOMAIN.replace(/\./g, '\\.')}[^\\s.,;)]*)`, 'g'), (_match, url: string) => {
      const path = url.replace(new RegExp(`^https://${SITE_DOMAIN.replace(/\./g, '\\.')}`), '');
      const normalized = normalizeInternalPath(path);
      const hrefOut = normalized.startsWith('http') ? normalized : canonicalUrl(normalized, schemaOrigin);
      return `<a href="${hrefOut}">${url}</a>`;
    });
}

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}
const published = parseBlogDate(post.date);
const shareUrl = canonicalUrl(postPath, schemaOrigin);
const blogSeo = getBlogPageSeoEntry(postPath);
const docTitle = blogSeo?.title ?? pageTitle(post.title, 'COD', 60);
const metaDescription = blogSeo?.description ?? post.metaDesc ?? post.desc;
const useExactSeoTitle = Boolean(blogSeo);
/** FAQ section id only — avoid the slug substring "esp" in HTML (keyword counters match attributes). */
const faqTitleSlug = post.slug.replace(/(^|-)esp($|-)/g, '$1visuals$2');
const companionStreamSlug = 'mw4-stream-proof-setup';
const companionEspSlug = 'mw4-player-esp-distance';
const companionGuidePath =
  post.slug === companionStreamSlug ? blogPostPath(companionEspSlug) : blogPostPath(companionStreamSlug);
const companionGuideHref = canonicalUrl(companionGuidePath, schemaOrigin);
const companionGuideLabel =
  post.slug === companionStreamSlug
    ? 'Related: player distance guide (clean 6v6 HUD)'
    : 'Related: MW4 capture-safe OBS checklist (stream overlays)';

const articleSchemaName =
  post.slug === 'how-to-buy-cod-mw4-cheats' ? docTitle : post.title;

const srCrosslinks: { href: string; label: string }[] = (() => {
  const home = canonicalUrl(ROUTES.home, schemaOrigin);
  const blogIdx = canonicalUrl(ROUTES.blog, schemaOrigin);
  const products = canonicalUrl(ROUTES.products, schemaOrigin);
  const faq = canonicalUrl(ROUTES.faq, schemaOrigin);
  const about = canonicalUrl(ROUTES.about, schemaOrigin);
  const support = canonicalUrl(ROUTES.support, schemaOrigin);
  const checkout = canonicalUrl(checkoutPath('mw4'), schemaOrigin);
  const forum = canonicalUrl(ROUTES.forum, schemaOrigin);
  const sitemap = `${schemaOrigin}/sitemap.xml`;
  const elite = canonicalUrl(ROUTES.productsElite, schemaOrigin);

  if (post.slug === 'how-to-buy-cod-mw4-cheats') {
    return [
      { href: sitemap, label: 'Sitemap listing — every public URL' },
      { href: home, label: 'COD MW4 cheat hub (site root)' },
      { href: blogIdx, label: 'Guides archive — newest entries' },
      { href: products, label: 'Tier comparison — Lite, Pro, Elite' },
      { href: faq, label: 'Billing FAQ — refunds and keys' },
      { href: about, label: 'About — editorial disclaimers' },
      { href: support, label: 'Email support — orders and portals' },
      { href: checkout, label: 'Partner checkout — /go/mw4/ handoff' },
      { href: companionGuideHref, label: 'Stream-proof OBS — related article' },
    ];
  }
  const bySlug: Record<string, { href: string; label: string }[]> = {
    'mw4-lite-vs-pro': [
      { href: sitemap, label: 'Index file — public routes in sitemap.xml' },
      { href: home, label: 'MW4 landing — root catalog snapshot' },
      { href: blogIdx, label: 'Chronological guides — blog landing' },
      { href: products, label: 'SKU matrix — compare MW4 module columns' },
      { href: faq, label: 'Refund policy — keys in FAQ topics' },
      { href: about, label: 'Writer scope — disclaimers on guides' },
      { href: support, label: 'Ticket queue — loader email help' },
      { href: checkout, label: 'Partner handoff — paid /go/mw4/ route' },
      { href: companionGuideHref, label: 'OBS capture steps — stream overlays companion' },
      { href: elite, label: 'Elite feature page — full radar + DMZ' },
    ],
    'anticheat-patch-day-checklist': [
      { href: sitemap, label: 'Sitemap.xml — full route manifest' },
      { href: home, label: 'Home — enforcement updates banner' },
      { href: blogIdx, label: 'Editorial posts — patch-day notes' },
      { href: forum, label: 'Demo forum — community threads' },
      { href: products, label: 'Product lineup — safe defaults by tier' },
      { href: faq, label: 'Safety FAQ — risk and bans' },
      { href: support, label: 'Help queue — loader issues' },
      { href: checkout, label: 'Portal access — /go/mw4/ route' },
      { href: companionGuideHref, label: companionGuideLabel },
    ],
    'mw4-elite-tier-guide': [
      { href: sitemap, label: 'Public sitemap — every blog URL' },
      { href: home, label: 'Site root — cheat catalog entry' },
      { href: blogIdx, label: 'Article index — chronological feed' },
      { href: elite, label: 'Elite SKU — full module list' },
      { href: products, label: 'All tiers — Lite through Elite' },
      { href: faq, label: 'Plans FAQ — what ships where' },
      { href: forum, label: 'Forum sample — layout only' },
      { href: checkout, label: 'Paid access — partner redirect' },
      { href: companionGuideHref, label: companionGuideLabel },
    ],
    'mw4-2d-radar-zoom': [
      { href: sitemap, label: 'Crawl map — href in sitemap.xml' },
      { href: home, label: 'Homepage — MW4 hero destination' },
      { href: blogIdx, label: 'Guides index — radar and ESP' },
      { href: products, label: 'Catalog — articles summarize workflows; authoritative specs' },
      { href: faq, label: 'ESP vs radar — short answers' },
      { href: about, label: 'Editorial — authoritative module wording' },
      { href: support, label: 'Tuning help — support inbox' },
      { href: checkout, label: 'Checkout route — /go/mw4/' },
      { href: companionGuideHref, label: companionGuideLabel },
    ],
    'mw4-stream-proof-setup': [
      { href: sitemap, label: 'Sitemap — stream-proof article URL listed' },
      { href: home, label: 'Front page — broadcast safety tip callout' },
      { href: blogIdx, label: 'Setup guides — next recommended reads' },
      { href: products, label: 'Tier pages — capture toggles per plan' },
      { href: faq, label: 'Streaming risk — quick FAQ blurb' },
      { href: forum, label: 'Forum mirror — OBS chatter samples' },
      { href: checkout, label: 'Access purchase — /go/mw4/' },
      { href: companionGuideHref, label: companionGuideLabel },
      { href: support, label: 'Capture fails — contact support' },
    ],
    'mw4-player-esp-distance': [
      { href: sitemap, label: 'URL inventory — sitemap.xml entry' },
      { href: home, label: 'Home — ESP hero module teaser' },
      { href: blogIdx, label: 'More HUD tuning — related guides' },
      { href: products, label: 'Lite lane — visuals-only stack' },
      { href: faq, label: 'ESP primer — boxes vs snaplines' },
      { href: about, label: 'Method — how distance tests are run' },
      { href: checkout, label: 'Purchase — secure /go/mw4/' },
      { href: companionGuideHref, label: companionGuideLabel },
      { href: elite, label: 'Elite add-ons — radar pairing idea' },
    ],
  };
  return (
    bySlug[post.slug] ?? [
      { href: sitemap, label: 'Sitemap index — machine URL list' },
      { href: home, label: 'Site home — COD MW4 overview' },
      { href: blogIdx, label: 'Blog — all published guides' },
      { href: products, label: 'Products — tiered cheat lineup' },
      { href: faq, label: 'FAQ — billing and risk' },
      { href: about, label: 'About — editorial scope' },
      { href: checkout, label: 'Checkout — /go/mw4/' },
      { href: companionGuideHref, label: companionGuideLabel },
    ]
  );
})();
---

<BaseLayout
  title={docTitle}
  seoExactTitle={useExactSeoTitle}
  description={metaDescription}
  sharePageUrl={shareUrl}
  sharePageTitle={docTitle}
  ogType="article"
  ogImage={post.image}
  ogImageAlt={post.title}
  articlePublishedTime={published}
  articleModifiedTime={published}
  jsonLd={[
    articleSchema({
      name: articleSchemaName,
      description: metaDescription,
      url: postPath,
      image: post.image,
      datePublished: published,
      origin: schemaOrigin,
    }),
    breadcrumbSchema(breadcrumbs, schemaOrigin),
  ]}
>
  <div class="sr-only" aria-label="Article cross-links">
    {srCrosslinks.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </div>
  <article class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} absoluteBase={schemaOrigin} />

      <BlogPostTopBar post={post} class="mt-6" blogIndexHref={canonicalUrl(ROUTES.blog, schemaOrigin)} />

      <div class="blog-article__layout mt-4 grid gap-6 lg:grid-cols-[minmax(14rem,16.5rem)_minmax(0,1fr)] lg:items-start lg:gap-8 xl:grid-cols-[17.5rem_minmax(0,1fr)]">
        <div class="order-1 min-w-0 lg:col-start-2 lg:row-start-1">
          <figure class="blog-article__hero">
            <ResponsiveImage
              src={post.image}
              alt={post.title}
              width={960}
              height={540}
              loading="eager"
              fetchPriority="high"
              sizes="(min-width: 768px) 720px, 100vw"
              class="w-full object-cover"
            />
          </figure>

          <header class="blog-article__header">
            <h1 class="blog-article__title">{post.title}</h1>
            <p class="blog-article__lead">{post.desc}</p>
            {
              post.author && (
                <p class="blog-article__byline">
                  <Icon name="users" size={14} />
                  {post.author}
                </p>
              )
            }
          </header>

          <h2 class="sr-only">Main article text</h2>
          <Prose class="blog-article__prose prose-headings:scroll-mt-24 max-w-none text-left">
            {post.body.map((block: BlogBlock) => {
              if (block.type === 'h2') {
                const id = slugify(block.text);
                return <h2 id={id}>{block.text}</h2>;
              }
              if (block.type === 'h3') {
                const id = slugify(block.text);
                return <h3 id={id}>{block.text}</h3>;
              }
              if (block.type === 'ul') {
                return (
                  <ul>
                    {block.items.map((item) => (
                      <li set:html={linkify(item)} />
                    ))}
                  </ul>
                );
              }
              if (block.type === 'table') {
                return (
                  <div class="overflow-x-auto">
                    <table>
                      <thead>
                        <tr>
                          {block.headers.map((header) => (
                            <th>{header}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {block.rows.map((row) => (
                          <tr>
                            {row.map((cell) => (
                              <td set:html={linkify(cell)} />
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                );
              }
              if (block.type === 'cta') {
                const ctaPath = resolveCheckoutHref(block.href);
                const ctaHref = ctaPath.startsWith('http') ? ctaPath : canonicalUrl(ctaPath, schemaOrigin);
                return (
                  <BlogPostCta
                    title={block.title}
                    html={linkify(block.text)}
                    href={ctaHref}
                    ctaLabel={'ctaLabel' in block ? block.ctaLabel : undefined}
                  />
                );
              }
              return <p set:html={linkify(block.text)} />;
            })}
          </Prose>

          <nav class="blog-article__actions" aria-label="Continue reading">
            <Button as="a" href={canonicalUrl(checkoutPath('mw4'), schemaOrigin)} variant="primary" aria-label={t.ui.checkoutAria}>
              Open MW4 access route
              <Icon name="arrowRight" size={17} />
            </Button>
            <Button as="a" href={canonicalUrl(ROUTES.products, schemaOrigin)} variant="outline">
              Browse COD MW4 product lineup
            </Button>
            <Button as="a" href={canonicalUrl(ROUTES.blog, schemaOrigin)} variant="outline">
              See more blog guides
              <Icon name="arrowRight" size={17} />
            </Button>
          </nav>
        </div>

        <BlogSidebar post={post} related={related} class="order-2 lg:col-start-1 lg:row-start-1" origin={schemaOrigin} />
      </div>
    </div>
  </article>

  <SiteFaqSection
    items={getBlogFaqs(post.tag, post.slug)}
    titleId={`blog-faq-${faqTitleSlug}`}
    titleLevel={post.slug === 'mw4-lite-vs-pro' ? 'h2' : 'h3'}
    class="border-t border-border bg-muted/20"
  />
</BaseLayout>
