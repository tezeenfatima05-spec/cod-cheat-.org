---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  blogPosts,
  getBlogTags,
  getFeaturedBlogPost,
  getNonFeaturedBlogPosts,
} from '../../data/blog';
import { t } from '../../i18n';
import { resolvePageSeo, canonicalUrl, resolveDocumentOrigin } from '../../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../../utils/schema';
import { CARD_IMAGE_WIDTHS, webpSrc } from '../../utils/responsiveImage';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogSortSelect from '../../components/BlogSortSelect.astro';
import Icon from '../../components/icons/Icon.astro';
import { blogTagIcons } from '../../data/sectionIcons';
import type { IconName } from '../../components/icons/types';
import { Button } from '@/components/starwind/button';
import { ROUTES, blogPostPath, productPath } from '../../utils/path';
import { checkoutPath } from '../../config/checkout';

const seo = resolvePageSeo('/blog/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
];

const featured = getFeaturedBlogPost();
const gridPosts = getNonFeaturedBlogPosts();
const tags = getBlogTags();
const lcpImage = webpSrc(featured?.image ?? blogPosts[0]!.image, CARD_IMAGE_WIDTHS[0]);

const tagIcon = (tag: string): IconName => blogTagIcons[tag] ?? 'tag';
const schemaOrigin = resolveDocumentOrigin(Astro.site);
const shareUrl = canonicalUrl('/blog/', schemaOrigin);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  sharePageUrl={shareUrl}
  sharePageTitle={seo.title}
  jsonLd={[
    collectionPageSchema({
      name: t.blog.title,
      description: t.blog.subtitle,
      url: '/blog/',
      origin: schemaOrigin,
    }),
    breadcrumbSchema(breadcrumbs, schemaOrigin),
  ]}
>
  <link slot="head" rel="preload" as="image" href={lcpImage} type="image/webp" fetchpriority="high" />

  <h1 class="sr-only">{seo.title}</h1>

  <div class="sr-only" aria-label="Related site entry points">
    <a href={`${schemaOrigin}/sitemap.xml`}>Href manifest serialized as application/xml</a>
    <a href={canonicalUrl(ROUTES.home, schemaOrigin)}>Canonical entry: hero, features, and product strip</a>
    <a href={canonicalUrl(ROUTES.products, schemaOrigin)}>Side-by-side module columns from entry to flagship</a>
    <a href={canonicalUrl(checkoutPath('mw4'), schemaOrigin)}>Short redirect slug before external cart host</a>
    <a href={canonicalUrl(ROUTES.faq, schemaOrigin)}>Billing FAQs: keys, HWID, and reversal rules</a>
    <a href={canonicalUrl(ROUTES.support, schemaOrigin)}>Human escalation when loaders refuse to bind</a>
    <a href={canonicalUrl(ROUTES.privacy, schemaOrigin)}>Cookie categories plus support email handling</a>
    <a href={canonicalUrl(ROUTES.terms, schemaOrigin)}>Sale terms tied to non-physical goods only</a>
    <a href={canonicalUrl(blogPostPath('mw4-player-esp-distance'), schemaOrigin)}>HUD clutter control: cap draw ranges in small maps</a>
    <a href={canonicalUrl(blogPostPath('mw4-triggerbot-guide'), schemaOrigin)}>Input timing: hold-to-gate vs spray discipline</a>
    <a href={canonicalUrl(blogPostPath('mw4-2d-radar-zoom'), schemaOrigin)}>Macro view: widen sweep lanes on large modes</a>
    <a href={canonicalUrl(ROUTES.about, schemaOrigin)}>What this publication reviews and what it skips</a>
    <a href={canonicalUrl(ROUTES.forum, schemaOrigin)}>Thread list preview without live accounts</a>
    <a href={canonicalUrl(ROUTES.productsElite, schemaOrigin)}>Flagship listing with every overlay family</a>
    <a href={canonicalUrl(productPath('lite'), schemaOrigin)}>Starter doc: boxes, bones, teammate filters</a>
    <a href={canonicalUrl(ROUTES.productsUtilities, schemaOrigin)}>Odds and ends: skins, UGC, account tools</a>
  </div>

  <div class="sr-only">Featured MW4 story section</div>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} absoluteBase={schemaOrigin} />
      {featured && (
        <BlogCard
          post={featured}
          index={0}
          eager
          showDate
          layout="featured"
          imageAlt={featured.title}
          linkBase={schemaOrigin}
        />
      )}
    </div>
  </section>

  <div class="sr-only">Article archive — filter and grid</div>
  <section class="border-y border-border bg-muted/20 py-12 md:py-16" aria-labelledby="blog-latest-title">
    <div class="mx-auto max-w-6xl px-5">
      <header class="section-header max-w-2xl">
        <p class="section-header__eyebrow">{t.blog.eyebrow}</p>
        <h2 id="blog-latest-title" class="section-header__title">
          Latest articles — Cod guides, setup, radar & patch notes
        </h2>
        <p class="section-header__subtitle">{t.blog.latestSubtitle}</p>
      </header>

      <div class="mt-8 flex flex-col gap-4 lg:mt-10 lg:flex-row lg:items-end lg:justify-between lg:gap-6">
        <div
          class="flex gap-2 overflow-x-auto pb-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          role="toolbar"
          aria-label="Filter articles by topic"
        >
          <button
            type="button"
            class="blog-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium shadow-xs hover:bg-muted"
            data-blog-filter="all"
            aria-pressed="true"
          >
            <span class="flex size-7 items-center justify-center rounded-full bg-muted text-primary" aria-hidden="true">
              <Icon name="navBlog" size={15} />
            </span>
            {t.blog.filterAll}
          </button>
          {
            tags.map((tag) => (
              <button
                type="button"
                class="blog-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium shadow-xs hover:bg-muted"
                data-blog-filter={tag}
                aria-pressed="false"
              >
                <span
                  class="flex size-7 items-center justify-center rounded-full bg-muted text-primary"
                  aria-hidden="true"
                >
                  <Icon name={tagIcon(tag)} size={15} />
                </span>
                {tag}
              </button>
            ))
          }
        </div>

        <BlogSortSelect />
      </div>

      <div
        id="blog-grid"
        class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-10"
        data-blog-empty-message={t.blog.emptyFilter}
      >
        {gridPosts.map((post, index) => (
          <BlogCard post={post} index={index} showDate imageAlt={post.title} linkBase={schemaOrigin} />
        ))}
      </div>

      <p id="blog-empty" class="mt-10 text-center text-muted-foreground" role="status" hidden>
        {t.blog.emptyFilter}
      </p>

      <div class="mt-12 flex justify-start lg:justify-center">
        <Button as="a" href={canonicalUrl(ROUTES.home, schemaOrigin)} variant="outline">
          <Icon name="chevronLeft" size={16} />
          Back to home
        </Button>
      </div>
    </div>
  </section>

</BaseLayout>
