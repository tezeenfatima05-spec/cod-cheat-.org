---
import "@/styles/starwind.css";
import { t } from '../i18n';
import {
  RSS_FEED_PATH,
  TWITTER_CREATOR,
  TWITTER_SITE,
  canonicalUrl,
  resolveDocumentOrigin,
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_HEIGHT,
  DEFAULT_OG_IMAGE_WIDTH,
  GA_MEASUREMENT_ID,
  absoluteAssetUrl,
} from '../config/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';

interface Props {
  title?: string;
  /** When true, use `title` verbatim as `<title>` (no homepage strip / truncation). */
  seoExactTitle?: boolean;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Absolute page URL for optional share intent links (server-rendered). */
  sharePageUrl?: string;
  sharePageTitle?: string;
  /** Homepage-only: skip redundant head share links to trim HTML weight (MEDIUM doc size). */
  omitHeadSocialSrLinks?: boolean;
  /** Homepage-only: keep X + Facebook only (still ≥2 intents; smaller `<head>`). */
  minimalHeadSocialSrLinks?: boolean;
  /** Skip duplicate body sr-only sitemap link when `<head>` already exposes it (homepage trim). */
  omitBodySitemapLink?: boolean;
  /** Homepage-only: drop redundant `og:locale:alternate` meta rows (smaller `<head>`). */
  trimOgLocales?: boolean;
  /** Homepage-only: smaller `<head>` (redundant crawler meta, fewer hreflang rows). */
  heavyHeadTrim?: boolean;
  /** Prefix same-origin nav/footer `<a href>` with deploy origin (canonical URL crawls). */
  linkAbsoluteBase?: string;
}

const {
  title = t.site.title,
  seoExactTitle = false,
  description = t.site.description,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = title,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  noindex = false,
  jsonLd,
  sharePageUrl,
  sharePageTitle,
  omitHeadSocialSrLinks = false,
  minimalHeadSocialSrLinks = false,
  omitBodySitemapLink = false,
  trimOgLocales = false,
  heavyHeadTrim = false,
  linkAbsoluteBase,
} = Astro.props;

const pathname = Astro.url.pathname;
const siteOriginTrim = resolveDocumentOrigin(Astro.site);
const homeHeadTrim = pathname === '/' && heavyHeadTrim;
/** Crawlers sometimes append `| Brand` or duplicate “– cod cheats”; strip for `/` only (SEO paste title stays exact). */
const documentTitle = seoExactTitle
  ? title
  : pathname === '/'
    ? title
        .replace(/\s*\|\s*COD\s+Cheats\s*$/i, '')
        .replace(/\s+[–—-]\s*cod\s+cheats\s*$/i, ' –')
        .trim()
    : title;
const imageAltForSocial = ogImageAlt === title ? documentTitle : ogImageAlt;
/** Nav/footer links: always same absolute origin as canonical/hreflang (crawlers compare hosts). */
const siteLinkBase = linkAbsoluteBase ?? siteOriginTrim;
const pageUrl = canonicalUrl(pathname, siteOriginTrim);
const sitemapAbsoluteUrl = `${siteOriginTrim}/sitemap.xml`;
const rssAbsoluteUrl = `${siteOriginTrim}${RSS_FEED_PATH}`;
const ogImageUrl = absoluteAssetUrl(ogImage, siteOriginTrim);
const shareUrl = sharePageUrl ?? pageUrl;
const shareText = sharePageTitle ?? documentTitle;
const xShare = `https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(shareText)}`;
const facebookShare = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`;
const telegramShare = `https://t.me/share/url?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(shareText)}`;
const redditShare = `https://www.reddit.com/submit?url=${encodeURIComponent(shareUrl)}&title=${encodeURIComponent(shareText)}`;
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<!doctype html>
<html lang="en" class="dark fonts-pending">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('colorTheme') || localStorage.getItem('starwind-theme');
          if (stored === 'light') document.documentElement.classList.remove('dark');
          else if (stored === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
        document.documentElement.classList.add('fonts-pending');
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {!homeHeadTrim && <meta name="author" content={t.site.name} />}
    <meta name="robots" content={robotsContent} />
    {!homeHeadTrim && <meta name="googlebot" content={robotsContent} />}
    <meta name="theme-color" content="#7F3DEE" />
    <link rel="canonical" href={pageUrl} />
    {
      homeHeadTrim ? (
        <>
          <link rel="alternate" hreflang="en" href={pageUrl} />
          <link rel="alternate" hreflang="x-default" href={pageUrl} />
        </>
      ) : (
        <>
          <link rel="alternate" hreflang="en" href={pageUrl} />
          <link rel="alternate" hreflang="en-US" href={pageUrl} />
          <link rel="alternate" hreflang="en-GB" href={pageUrl} />
          <link rel="alternate" hreflang="en-CA" href={pageUrl} />
          <link rel="alternate" hreflang="en-AU" href={pageUrl} />
          <link rel="alternate" hreflang="en-NZ" href={pageUrl} />
          <link rel="alternate" hreflang="en-IN" href={pageUrl} />
          <link rel="alternate" hreflang="en-SG" href={pageUrl} />
          <link rel="alternate" hreflang="en-IE" href={pageUrl} />
          <link rel="alternate" hreflang="en-ZA" href={pageUrl} />
          <link rel="alternate" hreflang="x-default" href={pageUrl} />
        </>
      )
    }
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${t.site.name} Blog RSS`}
      href={rssAbsoluteUrl}
    />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={sitemapAbsoluteUrl} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    {!homeHeadTrim && <meta property="og:image:secure_url" content={ogImageUrl} />}
    <meta property="og:image:alt" content={imageAltForSocial} />
    <meta property="og:image:width" content={String(DEFAULT_OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(DEFAULT_OG_IMAGE_HEIGHT)} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:locale" content="en_US" />
    {
      !trimOgLocales && (
        <>
          <meta property="og:locale:alternate" content="en_GB" />
          <meta property="og:locale:alternate" content="en_CA" />
          <meta property="og:locale:alternate" content="en_AU" />
          <meta property="og:locale:alternate" content="en_NZ" />
          <meta property="og:locale:alternate" content="en_IN" />
          <meta property="og:locale:alternate" content="en_SG" />
          <meta property="og:locale:alternate" content="en_IE" />
          <meta property="og:locale:alternate" content="en_ZA" />
        </>
      )
    }

    {
      ogType === 'article' && articlePublishedTime && (
        <>
          <meta property="article:published_time" content={articlePublishedTime} />
          <meta
            property="article:modified_time"
            content={articleModifiedTime ?? articlePublishedTime}
          />
          <meta property="article:author" content={t.site.name} />
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAltForSocial} />
    {TWITTER_SITE && <meta name="twitter:site" content={TWITTER_SITE} />}
    {TWITTER_CREATOR && <meta name="twitter:creator" content={TWITTER_CREATOR} />}

    {jsonLd && <JsonLd data={jsonLd} />}
    {
      !omitHeadSocialSrLinks && (
        <div class="sr-only" aria-label="Share this page">
          <a href={xShare}>Post {pathname} on X (Twitter)</a>
          <a href={facebookShare}>Share {pathname} on Facebook</a>
          {!minimalHeadSocialSrLinks && (
            <>
              <a href={telegramShare}>Send {pathname} link via Telegram</a>
              <a href={redditShare}>Submit {pathname} to Reddit</a>
            </>
          )}
        </div>
      )
    }
    <slot name="head" />

  </head>
  <body class="site-body min-h-screen bg-background text-foreground">
    <button type="button" class="skip-link" data-skip-to-main>{t.ui.skipLink}</button>
    {
      !omitBodySitemapLink && (
        <div class="sr-only">
          <a href={sitemapAbsoluteUrl}>Full URL list (XML sitemap index)</a>
        </div>
      )
    }
    <Header linkAbsoluteBase={siteLinkBase} />
    <main id="main-content">
      <slot />
    </main>
    <Footer linkAbsoluteBase={siteLinkBase} />
    <script>
      import '../scripts/site.ts';
    </script>
    {
      GA_MEASUREMENT_ID && (
        <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
          (() => {
            const loadGa = () => {
              if (window.__gaLoaded) return;
              window.__gaLoaded = true;
              window.dataLayer = window.dataLayer || [];
              function gtag() {
                dataLayer.push(arguments);
              }
              gtag('js', new Date());
              gtag('config', GA_MEASUREMENT_ID, { anonymize_ip: true });
              const s = document.createElement('script');
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
              s.async = true;
              document.head.appendChild(s);
            };
            const onReady = () => {
              if (typeof window.requestIdleCallback === 'function') {
                window.requestIdleCallback(loadGa, { timeout: 4000 });
              } else {
                window.setTimeout(loadGa, 2500);
              }
            };
            if (document.readyState === 'complete') onReady();
            else window.addEventListener('load', onReady, { once: true });
          })();
        </script>
      )
    }
  </body>
</html>
